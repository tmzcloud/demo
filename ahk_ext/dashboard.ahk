                    if sz > lastSz {
                        lastSz := sz
                        stallAt := A_TickCount
                    }
                    if (A_TickCount - lastTip) > 2000 {
                        lastTip := A_TickCount
                        if sz > 0 {
                            kb := Round(sz / 1024)
                            if logToHome
                                EmitImageProcLog("[i] aria2c… " kb " KB`n", false)
                            else
                                PushToolDownloadBoot(true, Min(72, 10 + Integer(sz / 30000)), title, "aria2c… " kb " KB")
                        }
                    }
                    if sz < 1000 && (A_TickCount - stallAt) > stallMs {
                        try ProcessClose(pid)
                        if logToHome
                            EmitImageProcLog("[!] aria2c 无进度`n", false)
                        break
                    }
                    if (A_TickCount - t0) > (limitMs + 2000) {
                        try ProcessClose(pid)
                        break
                    }
                }
                try FileDelete cmdFile
                if FileExist(partPath) && FileGetSize(partPath) >= minBytes {
                    try FileMove partPath, dest, 1
                    ok := FileExist(dest) && FileGetSize(dest) >= minBytes
                } else {
                    try FileDelete partPath
                    try FileDelete partPath ".aria2"
                }
            }
            ; ② curl 兜底
            if !ok && FileExist(curl) {
        tmp := dest ".part"
