    if !ok {
        try ok := DashboardDownloadFile(HANDLE_URL, dest)
    }
    if ok && FileExist(dest) && FileGetSize(dest) > 50000 {
        HANDLE_EXE := dest
        EmitImageProcLog("[√] handle64 已下载: " HANDLE_EXE "`n", false)
        return true
    }
    AppLog("EnsureHandle64 fail")
    EmitImageProcLog("[X] handle64 下载失败`n", false)
