Utf8TextToB64(text) {
    raw := StrReplace(String(text), "`r`n", "`n")
    raw := StrReplace(raw, "`r", "`n")
    buf := Buffer(StrPut(raw, "UTF-8") - 1)
    StrPut(raw, buf, "UTF-8")
    cch := 0
    if !DllCall("crypt32\CryptBinaryToStringW", "Ptr", buf, "UInt", buf.Size, "UInt", 0x40000001, "Ptr", 0, "UInt*", &cch)
        return ""
    wbuf := Buffer(cch * 2, 0)
    if !DllCall("crypt32\CryptBinaryToStringW", "Ptr", buf, "UInt", buf.Size, "UInt", 0x40000001, "Ptr", wbuf, "UInt*", &cch)
        return ""
    return RegExReplace(StrGet(wbuf, "UTF-16"), "[\r\n\s]+")
}

B64ToUtf8Text(b64) {
    b64 := RegExReplace(String(b64), "\s+")
    if b64 = ""
        return ""
    size := 0
    if !DllCall("crypt32\CryptStringToBinaryW", "WStr", b64, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", &size, "Ptr", 0, "Ptr", 0)
        return ""
    buf := Buffer(size)
    if !DllCall("crypt32\CryptStringToBinaryW", "WStr", b64, "UInt", 0, "UInt", 1, "Ptr", buf, "UInt*", &size, "Ptr", 0, "Ptr", 0)
        return ""
    return StrGet(buf, size, "UTF-8")
}

ResolveRemoveBgScriptPaths() {
    global PYTHON_EXT_AHK
    paths := []
    cmdExt := ResolveCommandExtDir()
    if cmdExt != "" {
        root := RTrim(cmdExt, "\/")
        dest := root "\script\remove_bg.py"
        ; 旧位置 ai\remove_bg.py → 迁入 ai\script\
        legacy := root "\remove_bg.py"
        if FileExist(legacy) && !FileExist(dest) {
            try {
                DirCreate(root "\script")
                FileMove(legacy, dest, 1)
            } catch {
                try FileCopy(legacy, dest, 1)
            }
        } else if FileExist(legacy) {
            try FileDelete legacy
        }
        paths.Push(dest)
    }
    paths.Push(A_ScriptDir "\ai\script\remove_bg.py")
    ; 仓库根下的 ship 副本（只作读源，写入时一并同步）
    paths.Push(A_ScriptDir "\remove_bg.py")
    ; 去重
    out := []
    seen := Map()
    for p in paths {
        key := StrLower(p)
        if seen.Has(key)
            continue
        seen[key] := true
        out.Push(p)
    }
    return out
}

ReadRemoveBgScriptText() {
    global PYTHON_EXT_AHK
    for p in ResolveRemoveBgScriptPaths() {
        if FileExist(p) {
            try {
                return FileRead(p, "UTF-8")
            } catch {
            }
        }
    }
    ; 从 _python_ext 嵌入块还原
    script := PYTHON_EXT_AHK
    if script = "" || !FileExist(script)
        script := A_ScriptDir "\_python_ext.ahk"
    if !FileExist(script)
        return ""
    try content := FileRead(script, "UTF-8")
    catch {
        return ""
    }
    mark := ";########################################################################################################### remove_bg.py"
    p1 := InStr(content, mark)
    p2 := p1 ? InStr(content, mark, false, p1 + StrLen(mark)) : 0
    if !(p1 && p2)
        return ""
    body := SubStr(content, p1 + StrLen(mark), p2 - p1 - StrLen(mark))
    body := RegExReplace(body, "[\r\n;]+", "")
    body := RegExReplace(body, "\s+", "")
    if body = "" || body = "xxxxx"
        return ""
    return B64ToUtf8Text(body)
}

SyncRemoveBgScriptFiles(*) {
    global PYTHON_EXT_AHK
    txt := ReadRemoveBgScriptText()
    if txt = ""
        return false
    b64 := Utf8TextToB64(txt)
    wrote := false
    for p in ResolveRemoveBgScriptPaths() {
        try {
            SplitPath p, , &dir
            if dir != "" && !DirExist(dir)
                DirCreate dir
            f := FileOpen(p, "w", "UTF-8")
            f.Write(txt)
            f.Close()
            wrote := true
