; url 可为字符串或数组。优先 aria2c，再 curl。minBytes 防错误页
DownloadFileToolProgress(urlOrUrls, dest, title := "下载组件", logToHome := false, minBytes := 50000) {
    try {
        urls := []
        if IsObject(urlOrUrls) {
            for u in urlOrUrls {
                u := Trim(String(u))
                if u = ""
                    continue
                if InStr(StrLower(u), "github.com/") {
                    canon := u
                    if RegExMatch(u, "i)https://(?:www\.)?github\.com/.+$", &gm)
                        canon := gm[0]
                    for x in ExpandGithubDownloadUrls(canon)
                        urls.Push(x)
                } else
                    urls.Push(u)
            }
        } else {
            for u in ExpandGithubDownloadUrls(urlOrUrls)
                urls.Push(u)
        }
        uniq := [], seen := Map()
        for u in urls {
            k := StrLower(u)
            if seen.Has(k)
                continue
            seen[k] := true
            uniq.Push(u)
        }
        urls := uniq
        if urls.Length < 1
            return false
        if FileExist(dest)
            try FileDelete dest
        SplitPath dest, , &destDir
        if destDir != ""
            DirCreate destDir
        aria := FindLocalAria2c()
        curl := A_WinDir "\System32\curl.exe"
        ua := "Mozilla/5.0"
        minBytes := Max(1000, Integer(minBytes))
        idx := 0
        for url in urls {
            idx += 1
            tip := title " (" idx "/" urls.Length ")"
            directGh := IsDirectGithubUrl(url)
            ; 镜像给足时间；直连很快放弃
            limitMs := directGh ? 45000 : 180000
            stallMs := directGh ? 12000 : 20000
            if logToHome
                EmitImageProcLog("[*] " tip " ← " url "`n", false)
            else
                PushToolDownloadBoot(true, 8, title, "正在连接…")
            ok := false
            ; ① aria2c（镜像多连接，直连单连接）
            if aria != "" {
                SplitPath dest, &destName
                partName := destName ".part"
                partPath := destDir "\" partName
                try FileDelete partPath
                try FileDelete partPath ".aria2"
                try FileDelete dest
                conn := directGh ? 1 : 8
                cmdFile := destDir "\_dl_aria_" A_TickCount ".cmd"
                cmdBody := "@echo off`r`n"
                    . '"' aria '" -c -x ' conn " -s " conn " -k 1M --connect-timeout=15 --timeout=" (directGh ? 40 : 120)
                    . " --max-tries=2 --file-allocation=none --allow-overwrite=true --auto-file-renaming=false"
                    . " --check-certificate=false --user-agent=" ua " --referer=https://github.com/"
                    . ' -d "' destDir '" -o "' partName '" "' url '"`r`n'
                try FileDelete cmdFile
                FileAppend cmdBody, cmdFile, "CP0"
                pid := 0
                Run('"' cmdFile '"', destDir, "Hide", &pid)
                t0 := A_TickCount
