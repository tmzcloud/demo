; 异步 HTTP GET：断网立刻回调空串；有网则 curl 后台跑，到期读一次文件
; 禁止 Download / WinHttp / RunWait / ProcessExist+Sleep（均可 Critical Error 或卡死主线程）
AsyncHttpGetInvoke(cb, body := "") {
    try cb.Call(body)
    catch {
    }
}
AsyncHttpGetText(url, timeoutSec, cb) {
    if !IsObject(cb)
        return
    url := Trim(String(url))
    if url = "" || IsProbablyOffline() {
        SetTimer(AsyncHttpGetInvoke.Bind(cb, ""), -1)
        return
    }
    timeoutSec := Max(2, Min(Integer(timeoutSec), 6))
    tmp := A_Temp "\dash_http_" A_TickCount "_" Random(1000, 9999) ".tmp"
    try FileDelete tmp
    curl := A_WinDir "\System32\curl.exe"
    if !FileExist(curl) {
        SetTimer(AsyncHttpGetInvoke.Bind(cb, ""), -1)
        return
    }
    cmd := Format('"{1}" -fsSL --connect-timeout {2} --max-time {3} -o "{4}" "{5}"'
        , curl, Min(timeoutSec, 3), timeoutSec, tmp, url)
    try Run(cmd, , "Hide")
    catch {
        SetTimer(AsyncHttpGetInvoke.Bind(cb, ""), -1)
        return
    }
    ; 单次延期回调，不轮询
    SetTimer(AsyncHttpGetFinish.Bind(tmp, cb), -(timeoutSec + 2) * 1000)
}
AsyncHttpGetFinish(tmp, cb) {
    body := ""
    try {
        if FileExist(tmp) && FileGetSize(tmp) > 0
            body := FileRead(tmp, "UTF-8")
    } catch {
        body := ""
    }
    try FileDelete tmp
    AsyncHttpGetInvoke(cb, Trim(body) != "" ? body : "")
}

