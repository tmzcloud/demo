EnsureHandle64() {
    global HANDLE_EXE, HANDLE_URL, HANDLE_DIR
    try DirCreate(HANDLE_DIR)
    HANDLE_EXE := HANDLE_DIR "\handle64.exe"
    got := ResolveHandle64Path()
    if got != "" {
