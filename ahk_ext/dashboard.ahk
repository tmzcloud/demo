; 有 HELPME_HOME → %HELPME_HOME%\ahk_ext\lib
; 搜索依赖（Everything/ES/ripgrep）与关联句柄（handle64）一律落这里，不写 demo\lib
ResolveAhkExtLibDir() {
    home := ""
    try home := EnvGet("HELPME_HOME")
    home := Trim(String(home))
    if home != "" {
        dir := RTrim(home, "\/") "\ahk_ext\lib"
        try DirCreate dir
        for sub in ["everything", "ripgrep", "handle", "webview2"]
            try DirCreate(dir "\" sub)
        return dir
    }
    dir := A_ScriptDir "\lib"
    try DirCreate dir
    for sub in ["everything", "ripgrep", "handle", "webview2"]
        try DirCreate(dir "\" sub)
    return dir
}

ResolveLocalSearchDir() {
    root := ResolveAhkExtDataRoot()
    dir := root "\local_search"
    try DirCreate dir
    legacy := ""
    home := ""
    try home := EnvGet("HELPME_HOME")
    home := Trim(String(home))
    if home != ""
        legacy := RTrim(home, "\/") "\ahk_ext\ahk\local_search"
    else
        legacy := A_ScriptDir "\ahk\local_search"
    MigrateLegacyDataDir(legacy, dir)
    ; 开发时脚本在 demo、数据在 HELPME：也把脚本旁旧 local_search 迁过去（仅目标尚无 index.html）
    if home != ""
        MigrateLegacyDataDir(A_ScriptDir "\data\local_search", dir)
    return dir
}

; 目标为空且旧目录有内容时，整体迁入
MigrateLegacyDataDir(legacy, preferred) {
    if legacy = "" || legacy = preferred || !DirExist(legacy)
        return
    if FileExist(preferred "\index.html")
        return
    hasLegacy := FileExist(legacy "\index.html")
    if !hasLegacy {
        try {
            loop files legacy "\*.*", "F" {
                hasLegacy := true
                break
            }
        }
    }
    if !hasLegacy
        return
    empty := true
    try {
        loop files preferred "\*.*", "FDR" {
            empty := false
            break
        }
    }
    if !empty
        return
    try DirMove(legacy, preferred, "R")
    catch {
        try DirCopy(legacy, preferred, 1)
    }
}

