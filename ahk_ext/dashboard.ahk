        }
    }
    ahk := PYTHON_EXT_AHK
    if ahk = "" || !FileExist(ahk)
        ahk := A_ScriptDir "\_python_ext.ahk"
    if b64 != "" && FileExist(ahk)
        UpdateEmbeddedCommentB64InFile(ahk, "remove_bg.py", b64)
    return wrote
}

