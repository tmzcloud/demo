; 杀掉残留的 remove_bg / 本目录 embed python，避免坏掉的 CUDA 上下文占坑
KillStaleRemoveBgPython() {
    killed := 0
    try {
        for proc in ComObjGet("winmgmts:").ExecQuery(
            "Select ProcessId,CommandLine from Win32_Process where Name='python.exe' or Name='pythonw.exe'") {
            cmd := ""
            try cmd := String(proc.CommandLine)
            if cmd = ""
                continue
            low := StrLower(cmd)
            hit := InStr(low, "remove_bg.py")
                || (InStr(low, "\ai\python\python") && InStr(low, "remove_bg"))
                || (InStr(low, "python_embed\python") && InStr(low, "remove_bg"))
                || InStr(low, "\_py_run_tmp.cmd")
            if !hit
                continue
            try {
                pid := Integer(proc.ProcessId)
                if pid > 0 {
                    ProcessClose(pid)
                    killed += 1
                }
            } catch {
            }
        }
    } catch {
    }
    if killed > 0 {
        EmitImageProcLog("[!] 已结束残留抠图进程 x" killed "（释放 CUDA）`n", false)
        Sleep 600
    }
}

; wheel/zip 末尾是否有 EOCD（损坏的半成品常缺这个）
WheelHasZipEocd(path) {
    path := String(path)
    if !FileExist(path)
        return false
    f := ""
    try f := FileOpen(path, "r")
    if !f
        return false
    sz := f.Length
    if sz < 22 {
        f.Close()
        return false
    }
    n := sz < 65536 ? Integer(sz) : 65536
    f.Seek(sz - n)
    buf := Buffer(n)
    f.RawRead(buf, n)
    f.Close()
    i := 0
    while i + 3 < n {
        if NumGet(buf, i, "UChar") = 0x50 && NumGet(buf, i + 1, "UChar") = 0x4B
            && NumGet(buf, i + 2, "UChar") = 0x05 && NumGet(buf, i + 3, "UChar") = 0x06
            return true
        i += 1
    }
    return false
}

; 若当前 torch 是 CPU 版，用 model\ 里的 cu118 wheel 钉回
EnsureCudaTorchForRemoveBg(cmdExt, pyExe) {
    cmdExt := RTrim(String(cmdExt), "\/")
    pyExe := String(pyExe)
    if !FileExist(pyExe)
        return
    probe := cmdExt "\model\_cuda_torch_probe.py"
    try FileDelete probe
    FileAppend(
        "import torch,sys`r`n"
        "print('ver', getattr(torch,'__version__',''))`r`n"
        "print('cuda', bool(torch.cuda.is_available()))`r`n"
        "sys.exit(0 if torch.cuda.is_available() else 1)`r`n",
        probe, "UTF-8-RAW")
    ec := 1
    try ec := RunWait('"' pyExe '" -u "' probe '"', cmdExt "\python", "Hide")
    catch {
        ec := 1
    }
    try FileDelete probe
    if ec = 0
        return
    EmitImageProcLog("[!] 检测到 CPU 版 torch（无 CUDA）。正在用本地 cu118 wheel 恢复…`n", false)
    whl := ""
    try {
        loop files cmdExt "\model\torch-2.1.2+cu118*.whl", "F" {
            ; 跳过明显损坏的 wheel（过小 / 缺 ZIP EOCD）
            sz := 0
            try sz := FileGetSize(A_LoopFileFullPath)
            if sz < 2000 * 1024 * 1024
                continue
            if !WheelHasZipEocd(A_LoopFileFullPath)
                continue
            whl := A_LoopFileFullPath
            break
        }
    } catch {
    }
    if whl = "" {
        EmitImageProcLog("[X] 未找到完整的 model\torch-2.1.2+cu118*.whl（可能损坏），请到主页重装「显卡加速」`n", false)
        return
    }
    tv := ""
    try {
        loop files cmdExt "\model\torchvision-0.16.2+cu118*.whl", "F" {
            tv := A_LoopFileFullPath
            break
        }
    } catch {
    }
    args := '-u -m pip install --no-warn-script-location --force-reinstall --no-deps "' whl '"'
    if tv != ""
        args .= ' "' tv '"'
    outLog := cmdExt "\model\_reinstall_cu118.out.log"
    try FileDelete outLog
    try RunWait('"' pyExe '" ' args ' > "' outLog '" 2>&1', cmdExt "\python", "Hide")
    catch as e {
        EmitImageProcLog("[X] 恢复 CUDA torch 失败: " e.Message "`n", false)
        return
    }
    ec2 := 1
    try {
        FileAppend(
            "import torch,sys`r`n"
            "print(torch.__version__, torch.cuda.is_available())`r`n"
            "sys.exit(0 if torch.cuda.is_available() else 1)`r`n",
            probe, "UTF-8-RAW")
        ec2 := RunWait('"' pyExe '" -u "' probe '"', cmdExt "\python", "Hide")
    } catch {
        ec2 := 1
    }
    try FileDelete probe
    if ec2 = 0
        EmitImageProcLog("[√] CUDA torch 已恢复，继续抠图`n", false)
    else
        EmitImageProcLog("[X] CUDA torch 仍不可用；抠图将很慢或失败，请主页重装「显卡加速」`n", false)
}

; imageProcRemoveBg|input|output|modelDir|threshold|feather|close
; output 为空 / __temp__：只写临时预览，等用户点「保存」再落到原图旁
StartRemoveBg(inputPath, outputPath, modelDir := "", thr := "", feather := "", closePx := "") {
    global REMOVE_BG_BUSY, REMOVE_BG_PID, REMOVE_BG_JOB, IMAGE_PROC_DIR
    ; 上次轮询因 global 漏写卡住时：进程已死则强制解锁
    if REMOVE_BG_BUSY {
        if REMOVE_BG_PID && ProcessExist(REMOVE_BG_PID) {
            EmitImageProcLog("[!] 抠图任务进行中，请稍候`n", false)
            return
        }
        REMOVE_BG_BUSY := false
        REMOVE_BG_PID := 0
        REMOVE_BG_JOB := ""
        try SetTimer(PollRemoveBgJob, 0)
    }
    KillStaleRemoveBgPython()
    inputPath := Trim(String(inputPath))
    outputPath := Trim(String(outputPath))
    modelDir := Trim(String(modelDir))
    thr := Trim(String(thr))
    feather := Trim(String(feather))
    closePx := Trim(String(closePx))
    if thr = ""
        thr := "0.5"
    if feather = ""
        feather := "1.2"
    if closePx = ""
        closePx := "2"
    try DirCreate IMAGE_PROC_DIR
    if outputPath = "" || StrLower(outputPath) = "__temp__"
        outputPath := IMAGE_PROC_DIR "\remove_bg_preview.png"
    cmdExt := ResolveCommandExtDir()
    pyExe := cmdExt "\python\python.exe"
    script := cmdExt "\script\remove_bg.py"
    if modelDir = ""
        modelDir := cmdExt "\model\BiRefNet"
    if !FileExist(pyExe) {
        EmitImageProcLog("[X] 未找到 python\python.exe，请先到主页下载依赖`n", false)
        EmitImageProcResult(false, inputPath, outputPath, "no python")
        return
    }
    ; 若 torch 被换成 CPU 版 → 抠图必挂；开跑前尽量钉回 cu118
    try EnsureCudaTorchForRemoveBg(cmdExt, pyExe)
    if !FileExist(script) {
        try SyncRemoveBgScriptFiles()
    }
    if !FileExist(script) {
        try DirCreate(cmdExt "\script")
        for src in [A_ScriptDir "\ai\script\remove_bg.py", A_ScriptDir "\remove_bg.py"] {
        if FileExist(src) {
            try FileCopy src, script, true
                break
            }
        }
    }
    if !FileExist(script) {
        EmitImageProcLog("[X] 未找到 remove_bg.py`n", false)
        EmitImageProcResult(false, inputPath, outputPath, "no script")
        return
    }
    if !FileExist(inputPath) {
        EmitImageProcLog("[X] 输入图片不存在: " inputPath "`n", false)
        EmitImageProcResult(false, inputPath, outputPath, "input missing")
        return
    }
    if !DirExist(modelDir) {
        EmitImageProcLog("[X] 模型目录不存在: " modelDir "`n", false)
        EmitImageProcResult(false, inputPath, outputPath, "model missing")
        return
    }
    try DirCreate IMAGE_PROC_DIR
    outLog := IMAGE_PROC_DIR "\remove_bg.out.log"
    ecFile := IMAGE_PROC_DIR "\remove_bg.exit.txt"
    bat := IMAGE_PROC_DIR "\remove_bg_run.cmd"
    try FileDelete outLog
    try FileDelete ecFile
    try FileDelete bat
    try FileAppend "", outLog, "UTF-8-RAW"

    EmitImageProcLog("[*] 开始 AI 抠图（预览）`n", false)
    EmitImageProcLog("[i] in  " inputPath "`n", false)
    EmitImageProcLog("[i] out " outputPath " （未保存到用户目录）`n", false)
    EmitImageProcLog("[i] model " modelDir "`n", false)
    EmitImageProcLog("[i] params thr=" thr " feather=" feather " close=" closePx "`n", false)
    ; 立即刷原图预览
    EmitImageProcResult(false, inputPath, "", "preview-only")

    ; 路径含空格：全部加引号；退出码写入文件（避免 echo N>file 坑）
    batBody := Format(
        "@echo off`r`nset PYTHONUNBUFFERED=1`r`nset PYTHONIOENCODING=utf-8`r`n"
        . "set PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128`r`n"
        . "set CUDA_DEVICE_ORDER=PCI_BUS_ID`r`n"
        . "set CUDA_VISIBLE_DEVICES=0`r`n"
        . '"{1}" -u "{2}" -i "{3}" -o "{4}" -m "{5}" --size 1024 --threshold {6} --feather {7} --close {8} > "{9}" 2>&1`r`n'
        . "set EC=%ERRORLEVEL%`r`n"
        . '> "{10}" echo %EC%`r`n'
        . "exit /b %EC%`r`n",
        pyExe, script, inputPath, outputPath, modelDir, thr, feather, closePx, outLog, ecFile)
    FileAppend batBody, bat, "UTF-8-RAW"

    REMOVE_BG_BUSY := true
    REMOVE_BG_PID := 0
    REMOVE_BG_JOB := {
        in: inputPath, out: outputPath,
        model: modelDir, thr: thr, feather: feather, close: closePx,
        log: outLog, ec: ecFile, bat: bat,
        pos: 0, t0: A_TickCount, beat: 0
    }
    try Run(bat, cmdExt "\python", "Hide", &REMOVE_BG_PID)
    catch as e {
        REMOVE_BG_BUSY := false
        REMOVE_BG_JOB := ""
        EmitImageProcLog("[X] 启动失败: " e.Message "`n", false)
        EmitImageProcResult(false, inputPath, outputPath, e.Message)
        return
    }
    SetTimer(PollRemoveBgJob, 400)
}

PollRemoveBgJob(*) {
    global REMOVE_BG_BUSY, REMOVE_BG_PID, REMOVE_BG_JOB, uiSizeMove
    if !REMOVE_BG_BUSY || !IsObject(REMOVE_BG_JOB)
        return
    if uiSizeMove
        return
    job := REMOVE_BG_JOB
    ; 刷增量日志
    try {
        if FileExist(job.log) {
            f := FileOpen(job.log, "r", "UTF-8")
            if IsObject(f) {
                if job.pos > f.Length
                    job.pos := 0
                f.Pos := job.pos
                chunk := f.Read()
                job.pos := f.Pos
                f.Close()
                if chunk != ""
                    EmitImageProcLog(chunk, false)
            }
        }
    } catch {
    }

    alive := REMOVE_BG_PID && ProcessExist(REMOVE_BG_PID)
    if alive {
        if (A_TickCount - job.beat) > 8000 {
            job.beat := A_TickCount
            EmitImageProcLog("[i] 抠图仍在运行…（已 " Integer((A_TickCount - job.t0) / 1000) " 秒）`n", false)
        }
        if (A_TickCount - job.t0) > 1800000 {
            EmitImageProcLog("[X] 抠图超时，结束进程`n", false)
            try ProcessClose(REMOVE_BG_PID)
        } else
            return
    }

    try ProcessWaitClose(REMOVE_BG_PID, 10)
    Sleep 200
    try {
        if FileExist(job.log) {
            f := FileOpen(job.log, "r", "UTF-8")
            if IsObject(f) {
                f.Pos := job.pos
                chunk := f.Read()
                f.Close()
                if chunk != ""
                    EmitImageProcLog(chunk, false)
            }
        }
    } catch {
    }

    exitCode := 1
    try {
        if FileExist(job.ec) {
            raw := Trim(FileRead(job.ec, "UTF-8"), " `t`r`n")
            if RegExMatch(raw, "^\d+$", &m)
                exitCode := Integer(m[0])
        }
    } catch {
        exitCode := 1
    }

    ok := (exitCode = 0 && FileExist(job.out))
    if ok {
        EmitImageProcLog("[√] 预览就绪（点顶栏保存写入文件）`n", false)
        EmitImageProcResult(true, job.in, job.out, "")
        REMOVE_BG_RETRY := 0
        REMOVE_BG_BUSY := false
        REMOVE_BG_PID := 0
        try FileDelete job.bat
        try FileDelete job.ec
        REMOVE_BG_JOB := ""
        SetTimer(PollRemoveBgJob, 0)
        return
    }

    ; CUDA 上下文损坏时：新开进程再跑一次（比同进程里硬扛 unknown error 更稳）
    cudaish := false
    try {
        if FileExist(job.log) {
            body := FileRead(job.log, "UTF-8")
            if RegExMatch(body, "i)CUDA|out of memory|Memory allocation failure|unknown error")
                cudaish := true
        }
    } catch {
    }
    inP := job.in
    outP := job.out
    modP := job.HasProp("model") ? job.model : ""
    thrP := job.HasProp("thr") ? job.thr : ""
    featherP := job.HasProp("feather") ? job.feather : ""
    closeP := job.HasProp("close") ? job.close : ""
    REMOVE_BG_BUSY := false
    REMOVE_BG_PID := 0
    try FileDelete job.bat
    try FileDelete job.ec
    REMOVE_BG_JOB := ""
    SetTimer(PollRemoveBgJob, 0)

    if cudaish && REMOVE_BG_RETRY < 1 {
        REMOVE_BG_RETRY += 1
        EmitImageProcLog("[!] CUDA 异常，自动新开进程重试（1/1）…`n", false)
        KillStaleRemoveBgPython()
        Sleep 800
        SetTimer(StartRemoveBg.Bind(inP, outP, modP, thrP, featherP, closeP), -200)
        return
    }
    REMOVE_BG_RETRY := 0
    EmitImageProcLog("[X] 抠图失败 exit=" exitCode "`n", false)
    EmitImageProcResult(false, inP, outP, "exit=" exitCode)
}

