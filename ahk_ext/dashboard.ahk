; 主页搜索依赖：只删本机 lib 下安装的文件，不碰系统 Everything
RemoveHomeSearchDep(id) {
    global EV_EXE, ES_EXE, RG_EXE, EV_DIR, RG_DIR, TOOLS_DIR, evReady
    id := StrLower(Trim(String(id)))
    if id = ""
        return
    labels := Map("everything", "Everything", "es", "ES", "ripgrep", "ripgrep")
    lab := labels.Has(id) ? labels[id] : id
    EmitImageProcLog("[*] 移除搜索依赖「" lab "」…`n", false)
    libEv := StrLower(RTrim(String(TOOLS_DIR), "\/"))
    try {
        if id = "everything" {
            ; 仅当当前进程指向本机 lib 拷贝时才停服务
            cur := ""
            try cur := StrLower(String(EV_EXE))
            if cur != "" && InStr(cur, libEv "\") {
                try StopEverythingService()
            }
            for name in ["Everything.exe", "everything.exe", "Everything.ini", "Everything.lng", "Everything-portable.zip"] {
                try FileDelete EV_DIR "\" name
            }
            EV_EXE := EV_DIR "\Everything.exe"
            evReady := false
            sysEv := ""
            try sysEv := FindSystemEverything()
            if sysEv != ""
                EmitImageProcLog("[!] 系统 Everything 仍在，节点可能仍显示已就绪；已清理本机 lib 拷贝`n", false)
        } else if id = "es" {
            cur := ""
            try cur := StrLower(String(ES_EXE))
            if cur = "" || InStr(cur, libEv "\") {
                try FileDelete ES_EXE
                try FileDelete EV_DIR "\es.exe"
                try FileDelete TOOLS_DIR "\es.exe"
                try FileDelete EV_DIR "\ES-portable.zip"
                try FileDelete TOOLS_DIR "\ES-portable.zip"
            } else {
                EmitImageProcLog("[!] ES 指向系统目录，跳过删除: " ES_EXE "`n", false)
            }
            ES_EXE := EV_DIR "\es.exe"
        } else if id = "ripgrep" {
            try FileDelete RG_EXE
            try {
                loop files RG_DIR "\rg.exe", "FR" {
                    try FileDelete A_LoopFileFullPath
                }
            } catch {
            }
            if DirExist(RG_DIR)
                try DirDelete RG_DIR, 1
            try DirCreate RG_DIR
            RG_EXE := RG_DIR "\rg.exe"
        } else {
            EmitImageProcLog("[!] 未知搜索依赖: " id "`n", false)
            return
        }
    } catch as e {
        EmitImageProcLog("[X] 移除失败: " e.Message "`n", false)
    }
    EmitImageProcLog("[√] 已请求移除「" lab "」，正在复查…`n", false)
    EmitHomeSearchStatus(true)
}

; 主页打开时探测修图依赖节点是否已就绪（绿点）
HomeAiPathOk(root, rel) {
    rel := Trim(String(rel))
    if rel = ""
        return false
    rel := StrReplace(rel, "/", "\")
    while SubStr(rel, 1, 1) = "\"
        rel := SubStr(rel, 2)
    p := RTrim(String(root), "\/") "\" rel
    if FileExist(p) || DirExist(p)
        return true
    return false
}

HomePipeRoots() {
    roots := []
    roots.Push(ResolveCommandExtDir())
    home := ""
    try home := Trim(EnvGet("HELPME_HOME"))
    if home != "" {
        h := RTrim(home, "\/")
        roots.Push(h "\ahk_ext\ai")
        roots.Push(h "\ahk_ext")
        roots.Push(h)
    }
    roots.Push(A_ScriptDir "\ai")
    roots.Push(A_ScriptDir)
    out := []
    seen := Map()
    for r in roots {
        k := StrLower(RTrim(String(r), "\/"))
        if k = "" || seen.Has(k)
            continue
        seen[k] := true
        out.Push(RTrim(String(r), "\/"))
    }
    return out
}

HomeAnyPath(cands*) {
    for p in cands {
        p := Trim(String(p))
        if p = ""
            continue
        if FileExist(p) || DirExist(p)
            return true
    }
    return false
}

