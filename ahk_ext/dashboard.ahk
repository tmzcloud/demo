SaveHomeSearchUrls(raw) {
    global EV_URL, ES_URL, RG_URL
    raw := Trim(String(raw))
    if raw = ""
        return
    ; 格式：id|url1||url2||url3
    pipe := InStr(raw, "|")
    if !pipe
        return
    id := StrLower(Trim(SubStr(raw, 1, pipe - 1)))
    urlsRaw := SubStr(raw, pipe + 1)
    urls := StrSplit(urlsRaw, "||")
    first := ""
    for u in urls {
        u := Trim(String(u))
        if u = ""
            continue
        if !RegExMatch(u, "i)^https?://")
            continue
        first := u
        break
    }
    if first = "" {
        EmitImageProcLog("[X] 未找到有效下载地址`n", false)
        return
    }
    if id = "everything"
        EV_URL := first
    else if id = "es"
        ES_URL := first
    else if id = "ripgrep"
        RG_URL := first
    else {
        EmitImageProcLog("[!] 未知搜索依赖: " id "`n", false)
        return
    }
    EmitImageProcLog("[√] 已更新「" id "」下载地址`n", false)
    EmitHomeSearchStatus()
}

