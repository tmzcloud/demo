UpdateEmbeddedCommentB64InFile(scriptPath, tag, newB64) {
    if scriptPath = "" || !FileExist(scriptPath)
        return false
    try content := FileRead(scriptPath, "UTF-8")
    catch {
        return false
    }
    mark := ";########################################################################################################### " String(tag)
    b64 := RegExReplace(String(newB64), "\s+")
    if b64 = ""
        b64 := "xxxxx"
    replacement := mark "`n;" b64 "`n" mark
    p1 := InStr(content, mark)
    if !p1 {
        if !RegExMatch(content, "`r?`n$")
            content .= "`n"
        content .= "`n" replacement "`n"
    } else {
        p2 := InStr(content, mark, false, p1 + StrLen(mark))
        if !p2
            content := SubStr(content, 1, p1 - 1) . replacement . SubStr(content, p1 + StrLen(mark))
        else
            content := SubStr(content, 1, p1 - 1) . replacement . SubStr(content, p2 + StrLen(mark))
    }
    try {
        f := FileOpen(scriptPath, "w", "UTF-8")
        f.Write(content)
        f.Close()
        return true
    } catch as e {
        AppLog("UpdateEmbeddedCommentB64InFile " e.Message)
        return false
    }
}

EmitImageProcPipeCfg(*) {
    global wvCore, PYTHON_EXT_AHK
    if !IsObject(wvCore)
        return
    path := ImageProcDeployCfgPath()
    raw := ""
    if FileExist(path) {
        try raw := FileRead(path, "UTF-8")
        catch {
            raw := ""
        }
    }
    if raw = "" {
        ; 尝试从 _python_ext 嵌入块还原
        if FileExist(PYTHON_EXT_AHK) {
            try {
                content := FileRead(PYTHON_EXT_AHK, "UTF-8")
                mark := ";########################################################################################################### deploy_pipe.json"
                p1 := InStr(content, mark)
                p2 := p1 ? InStr(content, mark, false, p1 + StrLen(mark)) : 0
                if p1 && p2 {
                    body := SubStr(content, p1 + StrLen(mark), p2 - p1 - StrLen(mark))
                    body := RegExReplace(body, "[\r\n;]+", "")
                    body := RegExReplace(body, "\s+", "")
                    if body != "" && body != "xxxxx" {
                        size := 0
                        if DllCall("crypt32\CryptStringToBinaryW", "WStr", body, "UInt", 0, "UInt", 1, "Ptr", 0, "UInt*", &size, "Ptr", 0, "Ptr", 0) {
                            buf := Buffer(size)
                            if DllCall("crypt32\CryptStringToBinaryW", "WStr", body, "UInt", 0, "UInt", 1, "Ptr", buf, "UInt*", &size, "Ptr", 0, "Ptr", 0)
                                raw := StrGet(buf, size, "UTF-8")
                        }
                    }
                }
            } catch {
            }
        }
    }
    if raw = ""
        raw := DefaultImageProcPipeJson()
    ; 旧配置 local:"remove_bg.py"（落在 ai\ 根）→ ai\script\remove_bg.py
    if RegExMatch(raw, '"script"\s*:\s*\{[^}]*"local"\s*:\s*"remove_bg\.py"')
        raw := RegExReplace(raw, '("script"\s*:\s*\{[^}]*"local"\s*:\s*")remove_bg\.py(")', "$1script\\remove_bg.py$2", &_, 1)
    root := ResolveCommandExtDir()
    try root := RTrim(DirExist(root) ? root : RTrim(A_ScriptDir, "\/") "\..", "\/")
    ; 注入 root（本机 HELPME_HOME\ahk_ext\ai）；AHK v2：Limit 是第 5 参
    if RegExMatch(raw, '"root"\s*:')
        raw := RegExReplace(raw, '"root"\s*:\s*"[^"]*"', '"root":' JStr(root), &_, 1)
    else if InStr(raw, "{") {
        brace := InStr(raw, "{")
        raw := SubStr(raw, 1, brace) . '"root":' JStr(root) "," . SubStr(raw, brace + 1)
    }
    js := "try{window.__applyImgProcPipeCfg&&window.__applyImgProcPipeCfg(" raw ")}catch(e){}"
    try wvCore.ExecuteScriptAsync(js)
}

