; 只补 WebView2 运行库（界面必需）；ripgrep/handle/Everything 不拷贝，留给用户测远程下载
SyncAhkExtLibFromScriptDir(*) {
    global LIB_DIR, APP_DIR
    srcRoot := RTrim(APP_DIR, "\/") "\lib"
    dstRoot := RTrim(LIB_DIR, "\/")
    if srcRoot = "" || dstRoot = "" || StrLower(srcRoot) = StrLower(dstRoot)
        return
    s := srcRoot "\webview2"
    d := dstRoot "\webview2"
    if !DirExist(s)
        return
    try DirCreate dstRoot
    if !DirExist(d) {
        try DirCopy s, d, 0
        return
    }
    for name in ["WebView2.ahk", "WebView2Loader.dll"] {
        if FileExist(s "\" name) && !FileExist(d "\" name)
            try FileCopy s "\" name, d "\" name, 0
    }
}

