            else if id = "model"
                ok := HomeAnyPath(root "\model\model.safetensors", root "\model\BiRefNet\model.safetensors")
            else if id = "pip"
                ok := HomeAnyPath(site "\transformers")
            else if id = "script"
                ok := HomeAnyPath(root "\script\remove_bg.py", root "\remove_bg.py", A_ScriptDir "\ai\script\remove_bg.py", A_ScriptDir "\remove_bg.py")
            if ok
                break
        }
        if ok
            okN += 1
        else
            missN += 1
        parts.Push('"' id '":"' (ok ? "done" : "idle") '"')
    }
    payload := "{"
    for i, s in parts {
        if i > 1
            payload .= ","
        payload .= s
    }
    payload .= "}"
    js := "try{window.__setHomePipeStatus&&window.__setHomePipeStatus(JSON.parse(" JStr(payload) "))}catch(e){}"
    try wvCore.ExecuteScriptAsync(js)
    catch {
    }
}

EmitImageProcLog(text, reset := false) {
    global wvCore
    if !IsObject(wvCore)
        return
    ; 单次注入过长 JS 会卡 WebView；按行切开发送
    t := String(text)
    flag := reset ? "true" : "false"
    if StrLen(t) > 4000 {
        parts := StrSplit(RegExReplace(t, "\r\n|\r", "`n"), "`n")
        first := true
        buf := ""
        for line in parts {
            if line = ""
                continue
            add := line "`n"
            if StrLen(buf) + StrLen(add) > 3500 && buf != "" {
                js := "try{window.__appendImageProcLog&&window.__appendImageProcLog(" JStr(buf) "," (first && reset ? "true" : "false") ")}catch(e){}"
                try wvCore.ExecuteScriptAsync(js)
                first := false
                buf := add
            } else
                buf .= add
        }
        if buf != "" {
            js := "try{window.__appendImageProcLog&&window.__appendImageProcLog(" JStr(buf) "," (first && reset ? "true" : "false") ")}catch(e){}"
            try wvCore.ExecuteScriptAsync(js)
        }
        return
    }
    js := "try{window.__appendImageProcLog&&window.__appendImageProcLog(" JStr(t) "," flag ")}catch(e){}"
    try wvCore.ExecuteScriptAsync(js)
}

