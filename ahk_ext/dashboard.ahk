FlushEmojiConfigEmbed(*) {
    global emojiEmbedArmed, EMOJI_CONFIG_TAG
    emojiEmbedArmed := false
    if !HasHelpmeHome()
        return
    path := AhkConfigPath("emoji")
    if path = "" || !FileExist(path)
