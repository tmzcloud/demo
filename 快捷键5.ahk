    ;分割大文件，输出到指定目录outDir
    static splitFile(fullpath ,n,outDir){
        dirName:=StrReplace(fullpath,(fileName := this.getSuffix(fullpath)),"")
        len:=strLen(fileContent:=fileRead(fullpath))
        segmentlen:=Ceil(len/n)
