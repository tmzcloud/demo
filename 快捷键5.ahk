     ;创建环境变量
     static createEnv()
     {
        this.helpmeHome:=this.InPath()?A_ScriptDir:reg.getEnv(this.helpmeEnv)
        if not this.helpmeHome
            throw Error("创建环境变量时发现init.helpmeHome未被初始化")
        this.helpme2Path:=this.helpmeHome
        this.helpme3Path:=this.helpmeHome "\" this.helpme3
