        }
        onrealoadMenu(*) {
            try WinPin.ForceUnpin()
            Reload
        }
        onExitMenu(*) {
            try WinPin.ForceUnpin()
            ExitApp
        }
     }
     ; 爱心托盘早于扩展脚本就绪；就绪前点托盘只记 pending
     static extrasReady := false
     static pendingShowLocalSearch := false
     ; 运行 ahk_ext 下扩展脚本。dashboard.ahk 不预启动——与资源管理器双击同一路径，点托盘再 Run
     static RunExtraScripts() {
         scriptDir := A_ScriptDir . "\ahk_ext"
         this.extrasReady := false
         if (!DirExist(scriptDir)) {
             this.extrasReady := true
             return
         }
         this.KillExtraScripts()
         this.KillExtraScriptsByBaseName(scriptDir)
         successCount := 0
         Loop Files scriptDir "\*.ahk", "F" {
             name := A_LoopFileName
             first := SubStr(name, 1, 1)
             if first = "." || first = "_"
                 continue
             currentName := StrReplace(name, ".ahk", "")
             ; dashboard 不预启动（托盘/热键按需 Run），但 tip 仍列出，避免托盘悬停看起来像丢了
             if StrLower(name) = "dashboard.ahk" {
                 ak.seticonTip("💚 " . currentName, 3 + successCount)
                 successCount++
                 continue
             }
             try {
                Run(Format('"{1}" "{2}" hosted', A_AhkPath, A_LoopFileFullPath), , "Hide")
                 ak.seticonTip("💚 " . currentName, 3 + successCount)
                 successCount++
             } catch Error as err {
                 OutputDebug("启动失败的脚本: " name " | 原因: " err.Message "`n")
             }
         }
         this.extrasReady := true
         if this.pendingShowLocalSearch {
             this.pendingShowLocalSearch := false
             SetTimer(() => init.ShowLocalSearchUi(), -120)
         }
         OutputDebug("🎉 纯静默运行完毕！共成功拉起 " successCount " 个扩展脚本。`n")
     }
     ; Alt+空格：已显示则关闭，否则打开
     static ToggleLocalSearchUi() {
         if this.IsLocalSearchUiVisible()
             this.HideLocalSearchUi()
         else
             this.ShowLocalSearchUi()
     }
     static IsLocalSearchUiVisible() {
         ; 主界面 Gui 标题为「仪表盘」；隐藏后 IsWindowVisible=0
         for hwnd in WinGetList("仪表盘") {
             try {
                 if DllCall("IsWindowVisible", "Ptr", hwnd)
                     return true
             }
         }
         return false
     }
     static ResolveDashboardPaths(&dash, &reqDir) {
         dash := A_ScriptDir "\ahk_ext\dashboard.ahk"
         if !FileExist(dash) {
             try {
                 if init.helpme2Path
                     dash := init.helpme2Path "\ahk_ext\dashboard.ahk"
             }
         }
         reqDir := ""
         if !FileExist(dash)
             return false
         SplitPath dash, , &dashDir
         try {
             if init.helpme2Path
                 reqDir := init.helpme2Path "\ahk_ext\data\local_search"
         }
         if reqDir = ""
             reqDir := dashDir "\data\local_search"
         return true
     }
     static FindDashboardScriptHwnd() {
         dash := ""
         reqDir := ""
         if !this.ResolveDashboardPaths(&dash, &reqDir)
             return 0
         oldDetect := DetectHiddenWindows(true)
         hwnd := WinExist(dash " ahk_class AutoHotkey")
         if !hwnd {
             for h in WinGetList("ahk_class AutoHotkey") {
                 try t := WinGetTitle("ahk_id " h)
                 catch
                     continue
                 if InStr(StrLower(t), "dashboard.ahk") {
                     hwnd := h
                     break
                 }
             }
         }
         DetectHiddenWindows(oldDetect)
         return hwnd
     }
     ; 进程级探测：窗口标题还没挂上时也能认出已在跑的 dashboard，避免再 Run 被 #SingleInstance 闪退
     static DashboardProcessRunning() {
         try {
             for proc in ComObjGet("winmgmts:").ExecQuery(
                 "Select ProcessId,CommandLine from Win32_Process where Name='AutoHotkey64.exe' or Name='AutoHotkey.exe' or Name='AutoHotkey32.exe'") {
                 cmdLine := ""
                 try cmdLine := proc.CommandLine
                 if !cmdLine
                     continue
                 cmd := StrLower(String(cmdLine))
                 if InStr(cmd, "\dashboard.ahk") || InStr(cmd, "/dashboard.ahk") || InStr(cmd, '"dashboard.ahk"')
                     return true
             }
         }
         return false
     }
     static HideLocalSearchUi() {
         dash := ""
         reqDir := ""
         if !this.ResolveDashboardPaths(&dash, &reqDir)
             return
         try {
             DirCreate(reqDir)
             try FileDelete(reqDir "\show.request")
             FileAppend String(A_TickCount), reqDir "\hide.request"
         }
         hwnd := this.FindDashboardScriptHwnd()
         if hwnd
             try PostMessage(0x8002, 0, 0, , "ahk_id " hwnd)
     }
     ; 托盘双击 = 资源管理器双击 dashboard.ahk（独立 show），不再走 hosted/轮询旁路
     static ShowLocalSearchUi() {
         if !this.extrasReady {
             this.pendingShowLocalSearch := true
             return
         }
         dash := ""
         reqDir := ""
         if !this.ResolveDashboardPaths(&dash, &reqDir) {
             try TrayTip("本地搜索", "未找到 ahk_ext\dashboard.ahk", "Iconx")
             return
         }
         ; 已在显示：置前即可
         if this.IsLocalSearchUiVisible() {
             try WinActivate("仪表盘")
             return
         }
         hwnd := this.FindDashboardScriptHwnd()
         if hwnd {
             ; 进程还在（关窗未退）：只唤出，勿再 Run
         try {
             DirCreate(reqDir)
                 try FileDelete(reqDir "\hide.request")
             FileAppend String(A_TickCount), reqDir "\show.request"
         }
             try PostMessage(0x8001, 0, 0, , "ahk_id " hwnd)
             return
         }
         ; 未运行：hosted+show → 立刻出界面且不占托盘图标（#NoTrayIcon）；不预挂后台 hosted
         try Run(Format('"{1}" "{2}" hosted show', A_AhkPath, dash), , "Hide")
         catch as e
             OutputDebug("ShowLocalSearchUi: " e.Message "`n")
     }
     ;关闭 主脚本打开的ahk_ext下的子脚本（当前目录 + helpme 镜像目录）
     static KillExtraScripts(ExitReason := 0, ExitCode := 0) {
         dirs := [A_ScriptDir . "\ahk_ext"]
         try {
             if init.helpme2Path && init.helpme2Path != A_ScriptDir
                 dirs.Push(init.helpme2Path . "\ahk_ext")
         }
         oldDetect := DetectHiddenWindows(true)
         for scriptDir in dirs {
             if !DirExist(scriptDir)
                 continue
             Loop Files scriptDir "\*.ahk", "F" {
                 targetTitle := A_LoopFileFullPath " ahk_class AutoHotkey"
                 if WinExist(targetTitle) {
                     WinClose(targetTitle)
                 }
             }
         }
         DetectHiddenWindows(oldDetect)
         ; 再按文件名兜底，防止路径不一致残留
         this.KillExtraScriptsByBaseName(A_ScriptDir . "\ahk_ext")
         return 0
     }
     ; 按脚本文件名杀掉所有 AutoHotkey 实例（不同盘符/路径也会命中）
     static KillExtraScriptsByBaseName(scriptDir := "") {
         if scriptDir = ""
             scriptDir := A_ScriptDir . "\ahk_ext"
         if !DirExist(scriptDir)
             return
         names := []
         Loop Files scriptDir "\*.ahk", "F"
             names.Push(StrLower(A_LoopFileName))
         if !names.Length
             return
         try {
             for proc in ComObjGet("winmgmts:").ExecQuery(
                 "Select ProcessId,CommandLine from Win32_Process where Name='AutoHotkey64.exe' or Name='AutoHotkey.exe' or Name='AutoHotkey32.exe'") {
                 cmdLine := ""
                 try cmdLine := proc.CommandLine
                 if !cmdLine
                     continue
                 cmd := StrLower(String(cmdLine))
                 for name in names {
                     if InStr(cmd, "\" name) || InStr(cmd, "/" name) || InStr(cmd, '"' name '"') {
                         try ProcessClose(Integer(proc.ProcessId))
                         break
                     }
                 }
             }
         } catch as e {
             OutputDebug("KillExtraScriptsByBaseName: " e.Message "`n")
         }
     }
}
