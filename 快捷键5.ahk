     ;Func 从剪贴板 CF_HDROP 取出所有图片文件路径（支持多选）
     static getClipboardImageFiles() {
         static imgExt := Map("png",1,"jpg",1,"jpeg",1,"gif",1,"bmp",1,"webp",1,"tif",1,"tiff",1,"ico",1,"heic",1,"jfif",1)
         files := []
         opened := false
         loop 8 {
             if DllCall("OpenClipboard", "Ptr", 0) {
                 opened := true
                 break
             }
             Sleep 20
         }
         if !opened
             return files
         try {
             hDrop := DllCall("GetClipboardData", "UInt", 15, "Ptr")  ; CF_HDROP
             if !hDrop
                 return files
             cnt := DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", 0xFFFFFFFF, "Ptr", 0, "UInt", 0, "UInt")
             loop cnt {
                 n := DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", A_Index - 1, "Ptr", 0, "UInt", 0, "UInt")
                 if n < 1
                     continue
                 buf := Buffer((n + 1) * 2, 0)
                 DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", A_Index - 1, "Ptr", buf, "UInt", n + 1, "UInt")
                 path := StrGet(buf, "UTF-16")
                 if path = "" || !FileExist(path) || InStr(FileExist(path), "D")
                     continue
                 dotPos := InStr(path, ".", false, -1)
                 ext := dotPos > 0 ? StrLower(SubStr(path, dotPos + 1)) : ""
                 if imgExt.Has(ext)
                     files.Push(path)
             }
         } finally {
             DllCall("CloseClipboard")
         }
         return files
     }
