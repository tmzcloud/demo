    ;获取当前某个环境变量的值 ，默认是当前用户
    static getEnv(key,user:=1)
    {
        return  ak.mapget(this.getEnvMap(user),key,1)
    }
    ;获取当前所有环境变量 ，默认是当前用户
    static getEnvMap(user:=1){
