; 托盘小图标：仪表盘用现成 🐍 app_snake.ico；其余为小 PNG（exit 红）
class TrayLineIcons {
    static cache := Map()
    static png := Map(
        "help", "",
        "pin", "",
        "unpin", "",
        "reload", "",
        "exit", ""
    )

    static SnakeIcoPath() {
        cands := [
            A_ScriptDir "\ahk_ext\data\local_search\app_snake.ico",
            A_ScriptDir "\data\local_search\app_snake.ico"
        ]
        try {
            if init.helpme2Path != ""
                cands.Push(init.helpme2Path "\ahk_ext\data\local_search\app_snake.ico")
        }
        for p in cands {
            if FileExist(p)
                return p
        }
        return ""
    }

    static Get(name) {
        if this.cache.Has(name)
            return this.cache[name]
        h := 0
        ; 仪表盘：复用 dashboard 的 🐍（IconN=资源序号，尺寸要用 w/h）
        if name = "dash" {
            ico := this.SnakeIcoPath()
            if ico != "" {
                try h := LoadPicture(ico, "w20 h20")
                if !h
                    try h := LoadPicture(ico, "w16 h16")
                if !h
                    try h := LoadPicture(ico)
            }
        }
        if !h && this.png.Has(name)
            try h := imageutil.Base64PNG_to_HICON(this.png[name], 20)
        if h
            this.cache[name] := h
        return h
    }

    static SetItem(tray, itemName, key) {
        ; 仪表盘优先直接绑 ico 文件（与 dashboard.TraySetIcon 同一写法）
        if key = "dash" {
            ico := this.SnakeIcoPath()
            if ico != "" {
                try {
                    tray.SetIcon(itemName, ico)
                    return
                }
            }
        }
        h := this.Get(key)
        if h
            try tray.SetIcon(itemName, "HICON: " h)
    }

    static Apply(tray) {
        this.SetItem(tray, "仪表盘", "dash")
        this.SetItem(tray, "ZH-文档帮助", "help")
        this.SetItem(tray, WinPin.PinMenuText(), "pin")
        this.SetItem(tray, WinPin.UnpinMenuText(), "unpin")
        this.SetItem(tray, "重启", "reload")
        this.SetItem(tray, "退出", "exit")
    }
}

; 托盘 Pin：可钉多个；退出 Pin / 关脚本 → 全部解除；淡绿 DWM 边框
class WinPin {
    static pins := Map() ; hwnd -> exe
    static picking := false
    static dwmBorder := 0x0090E090 ; COLORREF BGR 淡绿
    static pinMenuLabel := "Pin 窗口 (0)"
    static unpinMenuLabel := "退出 Pin (0)"

    static PinMenuText() => "Pin 窗口 (" this.pins.Count ")"
    static UnpinMenuText() => "退出 Pin (" this.pins.Count ")"

    static OnPinMenu(*) {
        if this.picking
            return
        this.StartPick()
    }

    static OnUnpinMenu(*) {
        if this.picking
            return
        if !this.pins.Count {
            try ak.showToolTip("当前没有已钉窗口", 1400)
            return
        }
        this.UnpinAll(true)
        try ak.showToolTip("已解除全部 Pin", 1400)
    }

    static RefreshMenuLabels() {
        tray := A_TrayMenu
        pinNew := this.PinMenuText()
        unpinNew := this.UnpinMenuText()
        if this.pinMenuLabel != pinNew {
            try tray.Rename(this.pinMenuLabel, pinNew)
            this.pinMenuLabel := pinNew
            try TrayLineIcons.SetItem(tray, pinNew, "pin")
        }
        if this.unpinMenuLabel != unpinNew {
            try tray.Rename(this.unpinMenuLabel, unpinNew)
            this.unpinMenuLabel := unpinNew
            try TrayLineIcons.SetItem(tray, unpinNew, "unpin")
        }
    }

    static StartPick() {
        if this.picking
            return
        this.picking := true
        this.SetCrossCursor(true)
        ToolTip("十字准心点选要钉住的窗口（Esc 取消）", 12, 12)
        try Hotkey("LButton", WinPin_OnPickClick, "On")
        try Hotkey("Escape", WinPin_OnPickCancel, "On")
    }

    static CancelPick() {
        if !this.picking
            return
        this.picking := false
        try Hotkey("LButton", WinPin_OnPickClick, "Off")
        try Hotkey("Escape", WinPin_OnPickCancel, "Off")
        ToolTip()
        this.SetCrossCursor(false)
    }

    static SetCrossCursor(on) {
        if !on {
            try ak.restoreCursors()
            return
        }
        cross := DllCall("LoadCursor", "Ptr", 0, "Ptr", 32515, "Ptr")
        if !cross
            return
        for id in [32512, 32513, 32514, 32515, 32516, 32642, 32643, 32644, 32645, 32646, 32648, 32649, 32650] {
            hCopy := DllCall("CopyImage", "Ptr", cross, "UInt", 2, "Int", 0, "Int", 0, "UInt", 0, "Ptr")
            if hCopy
                DllCall("SetSystemCursor", "Ptr", hCopy, "UInt", id)
        }
    }

    static OnPickClick(*) {
        if !this.picking
            return
        ToolTip()
        Sleep 40
        hwnd := this.ResolveRootHwnd(this.WindowFromCursor())
        this.CancelPick()
        if !hwnd || !DllCall("IsWindow", "Ptr", hwnd) {
            try ak.showToolTip("未选中有效窗口", 1800)
            return
        }
        cls := ""
        try cls := WinGetClass("ahk_id " hwnd)
        if RegExMatch(cls, "i)^(Progman|WorkerW|Shell_TrayWnd|Shell_SecondaryTrayWnd|NotifyIconOverflowWindow)$") {
            try ak.showToolTip("不能钉住桌面/任务栏", 1800)
            return
        }
        if RegExMatch(cls, "i)^(tooltips_class32|AutoHotkey)$") {
            try ak.showToolTip("点到了提示层，请再试一次", 1800)
            return
        }
        this.Pin(hwnd)
    }

    static OnPickCancel(*) {
        this.CancelPick()
        try ak.showToolTip("已取消 Pin", 1200)
    }

    static WindowFromCursor() {
        pt := Buffer(8)
        DllCall("GetCursorPos", "Ptr", pt)
        hwnd := DllCall("WindowFromPoint", "Int64", NumGet(pt, 0, "Int64"), "Ptr")
        if !hwnd
            return 0
        cls := ""
        try cls := WinGetClass("ahk_id " hwnd)
        if RegExMatch(cls, "i)^tooltips_class32$") {
            Sleep 20
            DllCall("GetCursorPos", "Ptr", pt)
            hwnd := DllCall("WindowFromPoint", "Int64", NumGet(pt, 0, "Int64"), "Ptr")
        }
        return Integer(hwnd)
    }

    static ResolveRootHwnd(hwnd) {
        hwnd := Integer(hwnd)
        if hwnd <= 0
            return 0
        root := 0
        try root := DllCall("GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr")
        return root ? Integer(root) : hwnd
    }

    static SetTopMost(hwnd, on) {
        hwnd := Integer(hwnd)
        if !hwnd || !DllCall("IsWindow", "Ptr", hwnd)
            return false
        flag := on ? -1 : -2
        ok := DllCall("SetWindowPos", "Ptr", hwnd, "Ptr", flag
            , "Int", 0, "Int", 0, "Int", 0, "Int", 0
            , "UInt", 0x0001 | 0x0002 | 0x0010)
        try WinSetAlwaysOnTop(on ? 1 : 0, "ahk_id " hwnd)
        return !!ok
    }

    static Pin(hwnd) {
        hwnd := Integer(hwnd)
        if !DllCall("IsWindow", "Ptr", hwnd)
            return
        if this.pins.Has(hwnd) {
            try ak.showToolTip("该窗口已钉住", 1400)
            return
        }
        exe := ""
        try exe := WinGetProcessName("ahk_id " hwnd)
        if exe = ""
            exe := "window"
        if !this.SetTopMost(hwnd, true) {
            try ak.showToolTip("置顶失败：" exe, 2000)
            return
        }
        this.ApplyBorder(hwnd, true)
        this.pins[hwnd] := exe
        SetTimer(WinPin_Track, 1200)
        this.RefreshMenuLabels()
        title := ""
        try title := WinGetTitle("ahk_id " hwnd)
        tip := "已钉住(" this.pins.Count ")：" exe (title != "" ? (" — " SubStr(title, 1, 32)) : "")
        try ak.showToolTip(tip, 2200)
    }

    static UnpinAll(showTip := false) {
        this.ForceUnpin()
    }

    static ForceUnpin(*) {
        SetTimer(WinPin_Track, 0)
        for hwnd, _ in this.pins {
            this.ApplyBorder(hwnd, false)
            this.SetTopMost(hwnd, false)
        }
        this.pins.Clear()
        this.RefreshMenuLabels()
    }

    static ApplyBorder(hwnd, on) {
        hwnd := Integer(hwnd)
        if !hwnd
            return
        color := on ? this.dwmBorder : 0xFFFFFFFF
        try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 34, "UInt*", color, "UInt", 4)
    }

    static Track(*) {
        if !this.pins.Count
            return SetTimer(WinPin_Track, 0)
        dead := []
        for hwnd, _ in this.pins {
            if !DllCall("IsWindow", "Ptr", hwnd) {
                dead.Push(hwnd)
                continue
            }
            try {
                ex := WinGetExStyle("ahk_id " hwnd)
                if !(ex & 0x8)
                    this.SetTopMost(hwnd, true)
            }
        }
        if dead.Length {
            for hwnd in dead
                this.pins.Delete(hwnd)
            this.RefreshMenuLabels()
        }
        if !this.pins.Count
            SetTimer(WinPin_Track, 0)
    }
}

WinPin_OnPickClick(*) => WinPin.OnPickClick()
WinPin_OnPickCancel(*) => WinPin.OnPickCancel()
WinPin_Track(*) => WinPin.Track()

