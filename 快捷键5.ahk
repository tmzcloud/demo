;把html输出到桌面,一般用于调试
html(content,filename:="xxx.html",flag:=true)
{
   if not flag
        return
   T1:=FileExist(f:=A_desktop "\" filename)?fileDelete(f):""
   fileAppend content,f
}
;记录系统运行日志title：一个标题,e：Error对象
log(title,e)
{
    if init.sysPath and  FileExist(init.sysPath)=="D" ;日志文件夹
    {
        loop 100
            line.='-'
        line.=ak.getTimeStr("-"," ",":") . "[ " title " ]"
        line.= "`n"  . Format("Error: {1}`n{2}",e.Message,e.Stack)
        filePath:=init.sysPath . "\log_" . A_YYYY . "-" . A_MM . "-" . A_DD . ".txt"
        fileAppend(line,filePath)
    }
}
;记录run运行日志
runlog(title,content)
{
   if init.runPath and FileExist(init.runPath)=="D"{
       Loop 100
           line.="-"
       line.=ak.getTimeStr("-"," ",":") . "[" . title . "]"
       line.='`n' . content . "`n"
       filePath:=init.runPath . "\run_" . A_YYYY . "-" . A_MM . "-" . A_DD . ".txt"
       if fileExist(filePath){
            line.="`n" . fileRead(filePath)
            fileDelete(filePath)
       }
       fileAppend line ,filePath
   }
}
;----------------------------------------------------------------------------------------------------------外部依赖初始化 outDependData
class outDependData {
    ;检查 ahk_ext\lib\webview2：从主脚本末尾 gzip 注释块双向同步写出
    static webview2LibDir() {
        return A_ScriptDir "\ahk_ext\lib\webview2"
    }
    static init() {
        dir := this.webview2LibDir()
        try DirCreate(dir)
        ahkPath := dir "\WebView2.ahk"
        dllPath := dir "\WebView2Loader.dll"
        ; 兼容：旧 A_Temp / lib 根目录残留迁入（再走注释块同步）
        if !FileExist(ahkPath) && FileExist(A_Temp "\WebView2.ahk")
            try FileCopy(A_Temp "\WebView2.ahk", ahkPath, 1)
        if !FileExist(dllPath) && FileExist(A_Temp "\WebView2Loader.dll")
            try FileCopy(A_Temp "\WebView2Loader.dll", dllPath, 1)
        if !FileExist(ahkPath) && FileExist(A_ScriptDir "\ahk_ext\lib\WebView2.ahk")
            try FileCopy(A_ScriptDir "\ahk_ext\lib\WebView2.ahk", ahkPath, 1)
        if !FileExist(dllPath) && FileExist(A_ScriptDir "\ahk_ext\lib\WebView2Loader.dll")
            try FileCopy(A_ScriptDir "\ahk_ext\lib\WebView2Loader.dll", dllPath, 1)
        outDependData._syncOneFile("WebView2.ahk", ahkPath, true)
        outDependData._syncOneFile("WebView2Loader.dll", dllPath, true)
    }
    ;同步步执行
    static syncCreateConfig(){
        this._syncConfigs()
    }
    ;异步执行
    static asyncUpdateInitScriptAhkBase64(){
        setTimer ()=>this._updateInitScriptAhkBase64() ,-1
    }

    ;配置 / 扩展脚本同步（gzip+base64 在本脚本末尾注释块）
    ;包裹标记：;########################################################################################################### 文件名
    ;- 配置 txt：有磁盘 → 只回写嵌入（不覆盖用户配置）；无 → 从嵌入吐出（不比 mtime）
    ;- 顶层 ahk / WebView2：两边都有 → 按该块 sync_mtime
    ; 嵌套携带：HTML/py/_home_page 等 base64 留在对应脚本；快捷键5 只嵌顶层
    ; 回写顶层进快捷键5 前先 seal（磁盘→子脚本注释块）；吐出顶层后再 materialize 子资源
    ; 只嵌在父脚本里、不进快捷键5 顶层表的 ahk
    static _isNestedOnlyAhk(name) {
        n := StrLower(String(name))
        return n = "_home_page.ahk" || n = "_download_ext.ahk"
    }

    ; 父脚本 tag → [[子 tag, 相对 ahk_ext 路径], ...]
    static _nestedChildren(parentTag) {
        switch StrLower(Trim(String(parentTag))) {
            case "dashboard.ahk":
                return [
                    ["local_search_index.html", "data\local_search\index.html"],
                    ["_home_page.ahk", "_home_page.ahk"],
                    ["_download_ext.ahk", "_download_ext.ahk"]
                ]
            case "_home_page.ahk":
                return [
                    ["remove_bg.py", "ai\script\remove_bg.py"],
                    ["wm_inpaint_api.py", "ai\script\wm_inpaint_api.py"],
                    ["deploy_pipe.json", "data\image_proc\deploy_pipe.json"]
                ]
            case "clipboard.ahk":
                return [
                    ["clip_index.html", "data\clip_v1\index.html"]
                ]
        }
        return []
    }

    static _syncConfigs() {
        helpmeHome := reg.getEnv(init.helpmeEnv)
        if helpmeHome != "" {
            configDir := helpmeHome . "\" . init.configDir
            for name in ["getconfig.txt", "runconfig.txt", "sysconfig.txt"]
                outDependData._syncConfigPreferDisk(name, configDir "\" name)
        }
        extDir := A_ScriptDir "\ahk_ext"
        try DirCreate extDir
        seen := Map()
        if DirExist(extDir) {
            Loop Files extDir "\*.ahk", "F" {
                name := A_LoopFileName
                if SubStr(name, 1, 1) = "."
                    continue
                if outDependData._isNestedOnlyAhk(name)
                    continue
                if StrLower(name) = "webview2.ahk"
                    continue
                seen[StrLower(name)] := true
                try outDependData._syncOneFile(name, extDir "\" name, true)
                catch as e
                    OutputDebug("_syncConfigs disk " name " " e.Message "`n")
            }
        }
        ; 注释块 → 磁盘：缺文件时必须吐出（双向同步的「无则创建」）
        for name in outDependData._listAhkCommentTags() {
            key := StrLower(name)
            if seen.Has(key)
                continue
            if outDependData._isNestedOnlyAhk(name)
                continue
            ; WebView2 只落在 ahk_ext\lib\webview2，不写到 ahk_ext 根
            if key = "webview2.ahk" || key = "webview2loader.dll"
                continue
            seen[key] := true
            try outDependData._syncOneFile(name, extDir "\" name, true)
            catch as e
                OutputDebug("_syncConfigs embed→disk " name " " e.Message "`n")
            if !FileExist(extDir "\" name)
                OutputDebug("_syncConfigs still missing after sync: " extDir "\" name "`n")
        }
        ; WebView2 库：ahk_ext\lib\webview2 ↔ 主脚本注释块
        wvDir := extDir "\lib\webview2"
        try DirCreate wvDir
        try outDependData._syncOneFile("WebView2.ahk", wvDir "\WebView2.ahk", true)
        try outDependData._syncOneFile("WebView2Loader.dll", wvDir "\WebView2Loader.dll", true)
        ; 顶层吐出后：从父脚本注释块解出嵌套资源（HTML / _home_page / py …）
        dashPath := extDir "\dashboard.ahk"
        if FileExist(dashPath)
            outDependData._materializeNestedFromParent(dashPath, extDir)
        else {
            OutputDebug("_syncConfigs no dashboard.ahk after sync — check embed/decode`n")
            try TrayTip("同步失败", "未能从注释块写出 ahk_ext\dashboard.ahk", "Iconx")
        }
        clipPath := extDir "\clipboard.ahk"
        if FileExist(clipPath)
            outDependData._materializeNestedFromParent(clipPath, extDir)
    }

    ; 磁盘较新 → 写入父脚本注释块（seal 用）；嵌入较新不覆盖
    static _sealOneChild(parentPath, childTag, childPath) {
        if !FileExist(childPath)
            return false
        sz := 0
        try sz := Integer(FileGetSize(childPath))
        if sz < 100
            return false
        ft := ""
        try ft := FileGetTime(childPath, "M")
        if ft = ""
            ft := FormatTime(, "yyyyMMddHHmmss")
        embT := outDependData._readCommentSyncMtimeFromFile(parentPath, childTag)
        if embT != "" && embT = ft
            return false
        if embT != "" && embT > ft
            return false
        b64 := ""
        loop 3 {
            b64 := outDependData._encodeFileToBase64(childPath)
            if b64 != ""
                break
            Sleep 80
        }
        if b64 = "" {
            OutputDebug("_sealOneChild encode fail " childTag "`n")
            return false
        }
        outDependData._updateCommentB64InFile(parentPath, childTag, b64, ft)
        OutputDebug("_sealOneChild disk→" parentPath " " childTag "`n")
        return true
    }

    ; 自下而上：先 seal 孙子，再 seal 进父脚本
    static _sealParentTree(extDir, parentTag) {
        kids := outDependData._nestedChildren(parentTag)
        if kids.Length < 1
            return
        parentPath := extDir "\" parentTag
        if !FileExist(parentPath)
            return
        for item in kids {
            childTag := item[1]
            childPath := extDir "\" item[2]
            if outDependData._nestedChildren(childTag).Length > 0
                outDependData._sealParentTree(extDir, childTag)
            try outDependData._sealOneChild(parentPath, childTag, childPath)
            catch as e
                OutputDebug("_sealParentTree " parentTag "/" childTag " " e.Message "`n")
        }
    }

    static _maybeSealBeforePack(tag, filePath) {
        if outDependData._nestedChildren(tag).Length < 1
            return
        SplitPath filePath, , &extDir
        outDependData._sealParentTree(extDir, tag)
    }

    ; 从父脚本注释块解出子资源；规则同前：无文件直接吐；两边有则嵌套 sync_mtime 更新才覆盖
    static _materializeNestedFromParent(parentPath, extDir) {
        SplitPath parentPath, &parentName
        kids := outDependData._nestedChildren(parentName)
        if kids.Length < 1
            return
        for item in kids {
            name := item[1]
            dest := extDir "\" item[2]
            b64 := outDependData._readCommentB64FromFile(parentPath, name)
            if b64 = "" || b64 = "xxxxx"
                continue
            hasFile := false
            try {
                if FileExist(dest) && Integer(FileGetSize(dest)) > 100
                    hasFile := true
            }
            embedTime := outDependData._readCommentSyncMtimeFromFile(parentPath, name)
            if !hasFile {
                try {
                    outDependData._decodeCommentToFile(b64, dest)
                    if embedTime != ""
                        try FileSetTime(embedTime, dest, "M")
                    OutputDebug("_materializeNested create " parentName " → " name "`n")
                } catch as e
                    OutputDebug("_materializeNested create fail " name " " e.Message "`n")
            } else {
                destTime := ""
                try destTime := FileGetTime(dest, "M")
                if embedTime != "" && destTime != "" && embedTime > destTime {
                    try {
                        outDependData._decodeCommentToFile(b64, dest)
                        try FileSetTime(embedTime, dest, "M")
                        OutputDebug("_materializeNested embed→disk " name "`n")
                    } catch as e
                        OutputDebug("_materializeNested overwrite fail " name " " e.Message "`n")
                }
            }
            if FileExist(dest) && outDependData._nestedChildren(name).Length > 0
                outDependData._materializeNestedFromParent(dest, extDir)
        }
    }

    static _maybeMaterializeAfterUnpack(tag, filePath) {
        if outDependData._nestedChildren(tag).Length < 1
            return
        SplitPath filePath, , &extDir
        outDependData._materializeNestedFromParent(filePath, extDir)
    }

    ; 任意脚本文件内注释块的 sync_mtime（不依赖 A_ScriptFullPath）
    static _readCommentSyncMtimeFromFile(scriptPath, tag) {
        try content := FileRead(scriptPath, "UTF-8")
        catch
            return ""
        mark := outDependData._commentMark(tag)
        p1 := InStr(content, mark)
        if !p1
            return ""
        start := p1 + StrLen(mark)
        p2 := InStr(content, mark, false, start)
        if !p2
            return ""
        block := SubStr(content, start, p2 - start)
        if RegExMatch(block, "i)sync_mtime=(\d{14})", &m)
            return m[1]
        return ""
    }

    ; 从任意脚本文件读取注释块 base64（不依赖 A_ScriptFullPath）
    static _readCommentB64FromFile(scriptPath, tag) {
        try content := FileRead(scriptPath, "UTF-8")
        catch
            return ""
        mark := outDependData._commentMark(tag)
        p1 := InStr(content, mark)
        if !p1
            return ""
        start := p1 + StrLen(mark)
        if SubStr(content, start, 1) = "`r"
            start += 1
        if SubStr(content, start, 1) = "`n"
            start += 1
        p2 := InStr(content, mark, false, start)
        if !p2
            return ""
        block := SubStr(content, start, p2 - start)
        out := ""
        for line in StrSplit(block, "`n", "`r") {
            line := Trim(line)
            if line = ""
                continue
            if SubStr(line, 1, 1) = ";"
                line := SubStr(line, 2)
            line := Trim(line)
            if InStr(line, "sync_mtime=") = 1
                continue
            line := RegExReplace(line, "\s+")
            if line = "" || line = "xxxxx"
                continue
            out .= line
        }
        return out
    }

    ; 扫描本脚本注释标记，收集 tag 以 .ahk 结尾的扩展脚本名
    static _listAhkCommentTags() {
        tags := []
        try content := FileRead(A_ScriptFullPath, "UTF-8")
        catch
            return tags
        markPrefix := ";########################################################################################################### "
        pos := 1
        while (p := InStr(content, markPrefix, false, pos)) {
            start := p + StrLen(markPrefix)
            end := start
            len := StrLen(content)
            while end <= len {
                ch := SubStr(content, end, 1)
                if ch = "`n" || ch = "`r"
                    break
                end += 1
            }
            tag := Trim(SubStr(content, start, end - start))
            if RegExMatch(tag, "i)\.ahk$") {
                ; 每个块有起止两个相同标记，去重
                dup := false
                for t in tags {
                    if t = tag {
                        dup := true
                        break
                    }
                }
                if !dup
                    tags.Push(tag)
            }
            pos := end
        }
        return tags
    }

    ; 配置专用：有文件只回写嵌入，绝不覆盖磁盘；无文件才从嵌入吐出
    static _syncConfigPreferDisk(tag, filePath) {
        SplitPath filePath, , &dir
        if dir != "" && !DirExist(dir)
            DirCreate dir
        curB64 := outDependData._readScriptCommentB64(tag)
        hasFile := !!FileExist(filePath)
        hasB64 := (curB64 != "" && curB64 != "xxxxx")
        if hasFile {
            ; 旧裸 base64 也升成 gzip，但以磁盘为准
            diskB64 := outDependData._encodeFileToBase64(filePath)
            if diskB64 = ""
                return
            if diskB64 = curB64
                return
            ; 配置不比 mtime，有磁盘只回写嵌入
            outDependData._updateScriptCommentB64(tag, diskB64, "")
            return
        }
        if hasB64 {
            try outDependData._decodeCommentToFile(curB64, filePath)
            catch as e
                OutputDebug("_syncConfigPreferDisk create fail " tag " " e.Message "`n")
        }
    }

    ; allowWriteBack：true=双向；仅 ahk/二进制资源用。
    ; 顺序：①无有效磁盘文件 → 有嵌入就直接吐（不比时间）
    ;       ②两边都有 → 注释块 sync_mtime ↔ 磁盘 FileGetTime
    ;       ③只有磁盘 → 回写嵌入
    ; 有嵌套子资源的顶层（dashboard/clipboard）：pack 前 seal，unpack 后 materialize
    static _syncOneFile(tag, filePath, allowWriteBack := true) {
        SplitPath filePath, , &dir
        if dir != "" && !DirExist(dir)
            DirCreate dir
        curB64 := outDependData._readScriptCommentB64(tag)
        hasB64 := (curB64 != "" && curB64 != "xxxxx")
        fileSz := 0
        try {
            if FileExist(filePath)
                fileSz := Integer(FileGetSize(filePath))
        }
        hasFile := fileSz > 1000
        ; 损坏/过小：当成没有，下面走「直接吐」
        if FileExist(filePath) && !hasFile {
            try FileDelete(filePath)
        }

        ; ① 没有文件：有注释块就直接吐，绝不先比时间
        if !hasFile {
            if !hasB64 {
                OutputDebug("_syncOneFile skip " tag " — no file and no comment`n")
                return
            }
            try {
                outDependData._decodeCommentToFile(curB64, filePath)
                embT := outDependData._readCommentSyncMtime(tag)
                if embT != ""
                    try FileSetTime(embT, filePath, "M")
                OutputDebug("_syncOneFile create embed→disk " tag "`n")
                outDependData._maybeMaterializeAfterUnpack(tag, filePath)
            } catch as e
                OutputDebug("_syncOneFile create fail " tag " " e.Message "`n")
            if !FileExist(filePath)
                OutputDebug("_syncOneFile still missing after decode: " filePath "`n")
            return
        }

        ; 打包进快捷键5 前：先把子货封进本文件（可能抬高本文件 mtime）
        if allowWriteBack
            outDependData._maybeSealBeforePack(tag, filePath)

        ; 以下：磁盘已有有效文件
        if !hasB64 {
            if !allowWriteBack
                return
            newB64 := outDependData._encodeFileToBase64(filePath)
            if newB64 != "" {
                ft := FileGetTime(filePath, "M")
                if ft = ""
                    ft := FormatTime(, "yyyyMMddHHmmss")
                outDependData._updateScriptCommentB64(tag, newB64, ft)
                OutputDebug("_syncOneFile disk→embed (no embed) " tag "`n")
            }
            return
        }

        if !allowWriteBack
            return

        ; 旧裸 base64 → 升 gzip（仍以磁盘为准）
        if !outDependData._isGzipB64(curB64) {
            mig := outDependData._encodeFileToBase64(filePath)
            if mig != "" {
                ft := FileGetTime(filePath, "M")
                if ft = ""
                    ft := FormatTime(, "yyyyMMddHHmmss")
                outDependData._updateScriptCommentB64(tag, mig, ft)
                curB64 := mig
            }
        }

        ; ② 两边都有：才比 sync_mtime（字符串 yyyyMMddHHmmss，等长可直接比）
        fileTime := ""
        try fileTime := FileGetTime(filePath, "M")
        if fileTime = ""
            fileTime := FormatTime(, "yyyyMMddHHmmss")
        embedTime := outDependData._readCommentSyncMtime(tag)
        if embedTime != "" && fileTime = embedTime
            return
        if embedTime != "" && embedTime > fileTime {
            try {
                outDependData._decodeCommentToFile(curB64, filePath)
                FileSetTime(embedTime, filePath, "M")
                OutputDebug("_syncOneFile embed→disk (embed newer) " tag "`n")
                outDependData._maybeMaterializeAfterUnpack(tag, filePath)
            } catch as e
                OutputDebug("_syncOneFile overwrite fail " tag " " e.Message "`n")
            return
        }
        ; 磁盘较新（或嵌入无时间戳）→ 必须回写注释块；失败重试，避免首次静默跳过
        diskB64 := ""
        loop 3 {
            diskB64 := outDependData._encodeFileToBase64(filePath)
            if diskB64 != ""
                break
            Sleep 120
        }
        if diskB64 = "" {
            OutputDebug("_syncOneFile encode fail " tag " path=" filePath "`n")
            return
        }
        ; 内容相同也要刷新 sync_mtime：否则主脚本（快捷键5）mtime 不碰，看起来像「第一次没同步」
        if diskB64 = curB64 && embedTime != "" && fileTime = embedTime
            return
        outDependData._updateScriptCommentB64(tag, diskB64, fileTime)
        OutputDebug("_syncOneFile disk→embed " (diskB64 = curB64 ? "(stamp only) " : (embedTime = "" ? "(stamp) " : "(disk newer) ")) tag "`n")
    }

    ;注释块起止标记（tag = getconfig.txt / runconfig.txt / sysconfig.txt / 任意 ahk_ext\*.ahk 文件名）
    static _commentMark(tag) {
        return ";########################################################################################################### " String(tag)
    }

    ;从脚本注释块读取 base64（去掉行首 ;、空行、空白）
    static _readScriptCommentB64(tag) {
        content := FileRead(A_ScriptFullPath, "UTF-8")
        mark := outDependData._commentMark(tag)
        p1 := InStr(content, mark)
        if !p1
            return ""
        start := p1 + StrLen(mark)
        if SubStr(content, start, 1) = "`r"
            start += 1
        if SubStr(content, start, 1) = "`n"
            start += 1
        p2 := InStr(content, mark, false, start)
        if !p2
            return ""
        block := SubStr(content, start, p2 - start)
        out := ""
        for line in StrSplit(block, "`n", "`r") {
            line := Trim(line)
            if line = ""
                continue
            if SubStr(line, 1, 1) = ";"
                line := SubStr(line, 2)
            line := Trim(line)
            if InStr(line, "sync_mtime=") = 1
                continue
            line := RegExReplace(line, "\s+")
            if line = "" || line = "xxxxx"
                continue
            out .= line
        }
        return out
    }

    ; 注释块内 ;sync_mtime=yyyyMMddHHmmss —— 该 ahk/资源自己的时间，不是主脚本 mtime
    static _readCommentSyncMtime(tag) {
        content := FileRead(A_ScriptFullPath, "UTF-8")
        mark := outDependData._commentMark(tag)
        p1 := InStr(content, mark)
        if !p1
            return ""
        start := p1 + StrLen(mark)
        p2 := InStr(content, mark, false, start)
        if !p2
            return ""
        block := SubStr(content, start, p2 - start)
        if RegExMatch(block, "i)sync_mtime=(\d{14})", &m)
            return m[1]
        return ""
    }

    ;将文件 gzip 后再 base64（解码见 _decodeCommentToFile）
    static _encodeFileToBase64(path) {
        return outDependData._fileToGzipB64(path)
    }

    static _fileToGzipB64(path) {
        if !FileExist(path)
            return ""
        tmpGz := A_Temp "\helpme_gz_" A_TickCount "_" Random(1000, 9999) ".gz"
        try FileDelete tmpGz
        if !outDependData._psGzip(path, tmpGz, true)
            return ""
        b64 := ak.getBase64(tmpGz)
        try FileDelete tmpGz
        return b64
    }

    static _decodeCommentToFile(b64str, despath) {
        b64str := RegExReplace(String(b64str), "\s+")
        if b64str = "" || b64str = "xxxxx"
            return
        SplitPath despath, , &dir
        if dir != "" && !DirExist(dir)
            DirCreate dir
        ; 大块（dashboard/clipboard）走 PowerShell：AHK CryptStringToBinary+"str" 对超长串常 size=0 静默失败
        if StrLen(b64str) >= 4096 {
            if outDependData._psB64ToFile(b64str, despath)
                return
            OutputDebug("_decodeCommentToFile psB64 fail " despath " b64Len=" StrLen(b64str) "`n")
        }
        CRYPT_STRING_BASE64 := 0x1
        DllCall("Crypt32.dll\CryptStringToBinary", "str", b64str, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", 0, "uint*", &size:=0, "ptr", 0, "ptr", 0)
        if size = 0 {
            ; 小块失败再试 PS
            if outDependData._psB64ToFile(b64str, despath)
                return
            OutputDebug("_decodeCommentToFile crypt size=0 " despath "`n")
            return
        }
        buf := Buffer(size)
        DllCall("Crypt32.dll\CryptStringToBinary", "str", b64str, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", buf, "uint*", &size, "ptr", 0, "ptr", 0)
        isGzip := (size >= 2 && NumGet(buf, 0, "UChar") = 0x1F && NumGet(buf, 1, "UChar") = 0x8B)
        if !isGzip {
            ak.createFileByBase64(b64str, despath)
            return
        }
        tmpGz := A_Temp "\helpme_gz_" A_TickCount "_" Random(1000, 9999) ".gz"
        tmpOut := A_Temp "\helpme_out_" A_TickCount "_" Random(1000, 9999) ".bin"
        try FileDelete tmpGz
        try FileDelete tmpOut
        f := FileOpen(tmpGz, "w")
        if !f
            return
        try f.RawWrite(buf, size)
        finally f.Close()
        ok := outDependData._psGzip(tmpGz, tmpOut, false)
        try FileDelete tmpGz
        if !ok || !FileExist(tmpOut) || FileGetSize(tmpOut) < 1 {
            try FileDelete tmpOut
            ; gzip 解压失败：整段改走 PS
            if outDependData._psB64ToFile(b64str, despath)
                return
            OutputDebug("_decodeCommentToFile gunzip fail " despath "`n")
            return
        }
        try FileDelete despath
        FileMove tmpOut, despath, 1
    }

    ; b64 文件落地：支持 gzip+base64 与裸 base64（不把超长串塞进命令行）
    static _psB64ToFile(b64str, despath) {
        b64str := RegExReplace(String(b64str), "\s+")
        if b64str = "" || despath = ""
            return false
        tmpB64 := A_Temp "\helpme_b64_" A_TickCount "_" Random(1000, 9999) ".b64"
        tmpOut := A_Temp "\helpme_b64out_" A_TickCount "_" Random(1000, 9999) ".bin"
        try FileDelete tmpB64
        try FileDelete tmpOut
        try {
            f := FileOpen(tmpB64, "w", "UTF-8-RAW")
            if !IsObject(f)
                return false
            f.Write(b64str)
            f.Close()
        } catch {
            return false
        }
        bp := StrReplace(tmpB64, "'", "''")
        dp := StrReplace(tmpOut, "'", "''")
        ps := "$ErrorActionPreference='Stop';$b64=[IO.File]::ReadAllText('" bp "').Trim();$raw=[Convert]::FromBase64String($b64);if($raw.Length -ge 2 -and $raw[0] -eq 0x1F -and $raw[1] -eq 0x8B){$ms=New-Object IO.MemoryStream(,$raw);$gz=New-Object IO.Compression.GZipStream($ms,[IO.Compression.CompressionMode]::Decompress);$fo=[IO.File]::Create('" dp "');try{$gz.CopyTo($fo)}finally{$gz.Dispose();$ms.Dispose();$fo.Dispose()}}else{[IO.File]::WriteAllBytes('" dp "',$raw)}"
        n := StrPut(ps, "UTF-16")
        wbuf := Buffer(n)
        StrPut(ps, wbuf, "UTF-16")
        raw := Buffer(n - 2)
        DllCall("RtlMoveMemory", "Ptr", raw, "Ptr", wbuf, "UPtr", n - 2)
        chars := 0
        DllCall("crypt32\CryptBinaryToStringW", "Ptr", raw, "UInt", raw.Size, "UInt", 0x40000001
            , "Ptr", 0, "UInt*", &chars)
        ob := Buffer(chars * 2)
        DllCall("crypt32\CryptBinaryToStringW", "Ptr", raw, "UInt", raw.Size, "UInt", 0x40000001
            , "Ptr", ob, "UInt*", &chars)
        enc := StrGet(ob, "UTF-16")
        ec := RunWait("powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand " enc, , "Hide")
        try FileDelete tmpB64
        if Integer(ec) != 0 || !FileExist(tmpOut) || FileGetSize(tmpOut) < 1 {
            try FileDelete tmpOut
            return false
        }
        try FileDelete despath
        FileMove tmpOut, despath, 1
        return FileExist(despath) && FileGetSize(despath) > 0
    }

    static _isGzipB64(b64str) {
        b64str := RegExReplace(String(b64str), "\s+")
        if b64str = "" || StrLen(b64str) < 8
            return false
        head := SubStr(b64str, 1, 24)
        CRYPT_STRING_BASE64 := 0x1
        DllCall("Crypt32.dll\CryptStringToBinary", "str", head, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", 0, "uint*", &size:=0, "ptr", 0, "ptr", 0)
        if size < 2
            return false
        buf := Buffer(size)
        DllCall("Crypt32.dll\CryptStringToBinary", "str", head, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", buf, "uint*", &size, "ptr", 0, "ptr", 0)
        return size >= 2 && NumGet(buf, 0, "UChar") = 0x1F && NumGet(buf, 1, "UChar") = 0x8B
    }

    static _psGzip(srcPath, destPath, compress) {
        try FileDelete destPath
        sp := StrReplace(srcPath, "'", "''")
        dp := StrReplace(destPath, "'", "''")
        if compress
            ps := "$ErrorActionPreference='Stop';$fs=[IO.File]::OpenRead('" sp "');$fo=[IO.File]::Create('" dp "');try{$gz=New-Object IO.Compression.GZipStream($fo,[IO.Compression.CompressionLevel]::Optimal);try{$fs.CopyTo($gz)}finally{$gz.Dispose()}}finally{$fs.Dispose();$fo.Dispose()}"
        else
            ps := "$ErrorActionPreference='Stop';$fs=[IO.File]::OpenRead('" sp "');$fo=[IO.File]::Create('" dp "');try{$gz=New-Object IO.Compression.GZipStream($fs,[IO.Compression.CompressionMode]::Decompress);try{$gz.CopyTo($fo)}finally{$gz.Dispose()}}finally{$fs.Dispose();$fo.Dispose()}"
        n := StrPut(ps, "UTF-16")
        wbuf := Buffer(n)
        StrPut(ps, wbuf, "UTF-16")
        raw := Buffer(n - 2)
        DllCall("RtlMoveMemory", "Ptr", raw, "Ptr", wbuf, "UPtr", n - 2)
        chars := 0
        DllCall("crypt32\CryptBinaryToStringW", "Ptr", raw, "UInt", raw.Size, "UInt", 0x40000001
            , "Ptr", 0, "UInt*", &chars)
        ob := Buffer(chars * 2)
        DllCall("crypt32\CryptBinaryToStringW", "Ptr", raw, "UInt", raw.Size, "UInt", 0x40000001
            , "Ptr", ob, "UInt*", &chars)
        enc := StrGet(ob, "UTF-16")
        ec := RunWait("powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand " enc, , "Hide")
        return Integer(ec) = 0 && FileExist(destPath) && FileGetSize(destPath) > 0
    }

    ; 脚本/资源：传入磁盘 FileGetTime 写 ;sync_mtime=；配置 txt 传 "" → 不写该行（不比 mtime）
    static _formatCommentB64Block(tag, b64, syncMtime := "") {
        mark := outDependData._commentMark(tag)
        b64 := RegExReplace(String(b64), "\s+")
        if b64 = "" || b64 = "xxxxx"
            b64 := "xxxxx"
        if syncMtime = ""
            return mark "`n;" b64 "`n" mark
        return mark "`n;sync_mtime=" syncMtime "`n;" b64 "`n" mark
    }

    ; 替换任意脚本文件中 tag 对应注释块；标记不存在则追加到末尾（seal 写父脚本用）
    static _updateCommentB64InFile(scriptPath, tag, newB64, syncMtime := "") {
        path := String(scriptPath)
        if path = ""
            return
        content := FileRead(path, "UTF-8")
        mark := outDependData._commentMark(tag)
        replacement := outDependData._formatCommentB64Block(tag, newB64, syncMtime)
        p1 := InStr(content, mark)
        if !p1 {
            if !RegExMatch(content, "`r?`n$")
                content .= "`n"
            content .= "`n" replacement "`n"
            f := FileOpen(path, "w", "UTF-8-RAW")
            f.Write(content)
            f.Close()
            return
        }
        p2 := InStr(content, mark, false, p1 + StrLen(mark))
        if !p2 {
            end := p1 + StrLen(mark)
            newContent := SubStr(content, 1, p1 - 1) . replacement . SubStr(content, end)
        } else {
            end := p2 + StrLen(mark)
            newContent := SubStr(content, 1, p1 - 1) . replacement . SubStr(content, end)
        }
        if newContent = content
            return
        f := FileOpen(path, "w", "UTF-8-RAW")
        f.Write(newContent)
        f.Close()
    }

    ; 替换本脚本（快捷键5）中 tag 对应注释块
