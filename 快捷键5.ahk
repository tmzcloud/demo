     ; 当前不在 HELPME_HOME 时：只同步主脚本；ahk_ext 由运行时 _syncConfigs 从注释块吐出，不再 FileCopy
     static copyFile2Helpme()
     {
         if (A_IsCompiled || !this.helpmeHome || A_ScriptDir = this.helpme2Path)
             return
         try {
             if !DirExist(this.helpme2Path)
                 DirCreate(this.helpme2Path)
             destMain := this.helpme2Path "\" A_ScriptName
             try FileCopy(A_ScriptFullPath, destMain, 1)
             catch as e
                 OutputDebug("copyFile2Helpme main failed: " e.Message "`n")
