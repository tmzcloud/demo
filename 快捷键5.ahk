     ;传入 base64 字符串，同步解码并写入目标文件（支持文本/二进制，不依赖 certutil）
     ;注意：脚本开头 FileEncoding UTF-8 时，FileOpen(...,"w") 会先写 BOM；若 buf 本身也有 BOM → 双 BOM，
     ;AHK 会把首行 #Requires 判成 “This line does not contain a recognized action.”
     static createFileByBase64(base64str, despath) {
        CRYPT_STRING_BASE64 := 0x1
        DllCall("Crypt32.dll\CryptStringToBinary", "str", base64str, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", 0, "uint*", &size:=0, "ptr", 0, "ptr", 0)
        if size = 0
            return
        buf := Buffer(size)
        DllCall("Crypt32.dll\CryptStringToBinary", "str", base64str, "uint", 0, "uint", CRYPT_STRING_BASE64
              , "ptr", buf, "uint*", &size, "ptr", 0, "ptr", 0)
        ; 去掉开头重复 UTF-8 BOM，以及末尾 NUL（注释块损坏时常见）
        off := 0
        while (off + 3 <= size
                && NumGet(buf, off, "UChar") = 0xEF
                && NumGet(buf, off + 1, "UChar") = 0xBB
                && NumGet(buf, off + 2, "UChar") = 0xBF)
            off += 3
        while (size > off && NumGet(buf, size - 1, "UChar") = 0)
            size -= 1
        writeSize := size - off
        if writeSize <= 0
            return
        try FileDelete despath
        ; UTF-8-RAW：禁止再自动插 BOM
        f := FileOpen(despath, "w", "UTF-8-RAW")
        if off = 0
            f.RawWrite(buf, writeSize)
        else {
            out := Buffer(writeSize)
            DllCall("RtlMoveMemory", "ptr", out, "ptr", buf.Ptr + off, "uptr", writeSize)
            f.RawWrite(out, writeSize)
        }
        f.Close()
     }
