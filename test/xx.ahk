#Requires AutoHotkey v2.0
; xx.ahk <-> parent ahk  bidirectional sync by mtime (gzip+base64 embed)

CLI := false
for a in A_Args {
    if (a = "/cli" || a = "-cli")
        CLI := true
}

MARK1 := "@@" "GZIP_B64_PAYLOAD_BEGIN" "@@"
MARK2 := "@@" "GZIP_B64_PAYLOAD_END" "@@"
AHK_PATH := GetFullPath(A_ScriptDir "\..\快捷键5.ahk")

for a in A_Args {
    if (a = "/show" || a = "-show") {
        b64 := ReadEmbedB64()
        if b64 = ""
            Report("embed empty", false)
        gz := B64ToBuf(b64)
        Report(
            "embed gzip+base64``n"
            "b64: " FormatBytes(StrLen(b64)) "``n"
            "gzip: " FormatBytes(gz.Size) "``n"
            "head: " HexHead(gz, 8) "``n"
            "ahk: " AHK_PATH "``n"
            "xx mtime: " FileGetTime(A_ScriptFullPath, "M")
        , true)
    }
}

ahkOk := !!FileExist(AHK_PATH)
b64 := ReadEmbedB64()
hasPayload := (b64 != "" && IsGzipB64(b64))

if !ahkOk && !hasPayload
    Report("no data either side``n" AHK_PATH, false)

dir := ""
detail := ""

if ahkOk && !hasPayload {
    PackAhkIntoXx()
    dir := "ahk -> xx"
} else if !ahkOk && hasPayload {
    UnpackXxToAhk()
    dir := "xx -> ahk"
} else {
    tAhk := FileGetTime(AHK_PATH, "M")
    tXx := FileGetTime(A_ScriptFullPath, "M")
    if tAhk = tXx {
        gz := B64ToBuf(b64)
        Report(
            "synced (same mtime)``n``n"
            "ahk: " tAhk "  (" FormatBytes(FileGetSize(AHK_PATH)) ")``n"
            "xx:  " tXx "  (gzip " FormatBytes(gz.Size) ")``n"
            "head: " HexHead(gz, 8)
        , true)
    } else if tAhk > tXx {
        PackAhkIntoXx()
        dir := "ahk -> xx"
        detail := "ahk " tAhk " > xx " tXx
    } else {
        UnpackXxToAhk()
        dir := "xx -> ahk"
        detail := "xx " tXx " > ahk " tAhk
    }
}

b64 := ReadEmbedB64()
gz := B64ToBuf(b64)
Report(
    "done``n``n"
    "dir: " dir "``n"
    (detail ? detail "``n" : "")
    "``nahk: " FormatBytes(FileGetSize(AHK_PATH)) "  " FileGetTime(AHK_PATH, "M") "``n"
    "xx:  gzip " FormatBytes(gz.Size) "  " FileGetTime(A_ScriptFullPath, "M") "``n"
    "head: " HexHead(gz, 8)
, true)

PackAhkIntoXx() {
    global AHK_PATH
    tSrc := FileGetTime(AHK_PATH, "M")
    tmpGz := A_ScriptDir "\._xx_" A_TickCount ".gz"
    try FileDelete tmpGz
    if !GzipFile(AHK_PATH, tmpGz)
        throw Error("gzip compress failed")
    gzBuf := ReadAllBytes(tmpGz)
    try FileDelete tmpGz
    WriteEmbedB64(BufToB64(gzBuf))
    FileSetTime tSrc, A_ScriptFullPath, "M"
}

UnpackXxToAhk() {
    global AHK_PATH
    tSrc := FileGetTime(A_ScriptFullPath, "M")
    b64 := ReadEmbedB64()
    if b64 = ""
        throw Error("embed empty")
    gzBuf := B64ToBuf(b64)
    tmpGz := A_ScriptDir "\._xx_" A_TickCount ".gz"
    tmpAhk := A_ScriptDir "\._xx_" A_TickCount ".ahk"
    try FileDelete tmpGz
    try FileDelete tmpAhk
    WriteAllBytes(tmpGz, gzBuf)
    if !GunzipFile(tmpGz, tmpAhk) {
        try FileDelete tmpGz
        throw Error("gzip decompress failed")
    }
    try FileDelete tmpGz
    dir := GetDir(AHK_PATH)
    if !DirExist(dir)
        DirCreate dir
    FileMove tmpAhk, AHK_PATH, 1
    FileSetTime tSrc, AHK_PATH, "M"
}

ReadEmbedB64() {
    global MARK1, MARK2
    txt := FileRead(A_ScriptFullPath, "UTF-8")
    i1 := InStr(txt, MARK1)
    i2 := InStr(txt, MARK2)
    if !i1 || !i2 || i2 <= i1
        return ""
    chunk := SubStr(txt, i1 + StrLen(MARK1), i2 - i1 - StrLen(MARK1))
    return RegExReplace(chunk, "\s+")
}

WriteEmbedB64(b64) {
    global MARK1, MARK2
    txt := FileRead(A_ScriptFullPath, "UTF-8")
    i1 := InStr(txt, MARK1)
    i2 := InStr(txt, MARK2)
    if !i1 || !i2 || i2 <= i1
        throw Error("embed markers missing")
    wrapped := ""
    lineLen := 76
    rest := b64
    loop {
        if rest = ""
            break
        take := Min(lineLen, StrLen(rest))
        wrapped .= SubStr(rest, 1, take) "`n"
        rest := SubStr(rest, take + 1)
    }
    head := SubStr(txt, 1, i1 + StrLen(MARK1) - 1)
    tail := SubStr(txt, i2)
    newTxt := head "`n" wrapped . tail
    f := FileOpen(A_ScriptFullPath, "w", "UTF-8")
    if !f
        throw Error("cannot write script")
    try f.Write(newTxt)
    finally f.Close()
}

IsGzipB64(b64) {
    try {
        buf := B64ToBuf(b64)
        return buf.Size >= 2 && NumGet(buf, 0, "UChar") = 0x1F && NumGet(buf, 1, "UChar") = 0x8B
    } catch {
        return false
    }
}

BufToB64(buf) {
    chars := 0
    if !DllCall("crypt32\CryptBinaryToStringW", "Ptr", buf, "UInt", buf.Size, "UInt", 0x1
        , "Ptr", 0, "UInt*", &chars)
        throw Error("CryptBinaryToString size failed")
    var := Buffer(chars * 2)
    if !DllCall("crypt32\CryptBinaryToStringW", "Ptr", buf, "UInt", buf.Size, "UInt", 0x1
        , "Ptr", var, "UInt*", &chars)
        throw Error("CryptBinaryToString failed")
    return RegExReplace(StrGet(var, "UTF-16"), "\s+")
}

B64ToBuf(b64) {
    n := 0
    if !DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 0x1
        , "Ptr", 0, "UInt*", &n, "UInt*", 0, "UInt*", 0)
        throw Error("base64 probe failed")
    buf := Buffer(n)
    if !DllCall("crypt32\CryptStringToBinaryW", "Str", b64, "UInt", 0, "UInt", 0x1
        , "Ptr", buf, "UInt*", &n, "UInt*", 0, "UInt*", 0)
        throw Error("base64 decode failed")
    return buf
}

GzipFile(srcPath, destPath) {
    return PsGzip(srcPath, destPath, true)
}
GunzipFile(srcPath, destPath) {
    return PsGzip(srcPath, destPath, false)
}

PsGzip(srcPath, destPath, compress) {
    try FileDelete destPath
    sp := EscapePs(srcPath)
    dp := EscapePs(destPath)
    if compress
        ps := "$ErrorActionPreference='Stop';$fs=[IO.File]::OpenRead('" sp "');$fo=[IO.File]::Create('" dp "');try{$gz=New-Object IO.Compression.GZipStream($fo,[IO.Compression.CompressionLevel]::Optimal);try{$fs.CopyTo($gz)}finally{$gz.Dispose()}}finally{$fs.Dispose();$fo.Dispose()}"
    else
        ps := "$ErrorActionPreference='Stop';$fs=[IO.File]::OpenRead('" sp "');$fo=[IO.File]::Create('" dp "');try{$gz=New-Object IO.Compression.GZipStream($fs,[IO.Compression.CompressionMode]::Decompress);try{$gz.CopyTo($fo)}finally{$gz.Dispose()}}finally{$fs.Dispose();$fo.Dispose()}"
    enc := PsEncode(ps)
    ec := RunWait("powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand " enc, A_ScriptDir, "Hide")
    return Integer(ec) = 0 && FileExist(destPath) && FileGetSize(destPath) > 0
}

PsEncode(s) {
    n := StrPut(s, "UTF-16")
    buf := Buffer(n)
    StrPut(s, buf, "UTF-16")
    raw := Buffer(n - 2)
    DllCall("RtlMoveMemory", "Ptr", raw, "Ptr", buf, "UPtr", n - 2)
    return BufToB64(raw)
}

Report(msg, ok := true) {
    global CLI
    if CLI {
        try FileAppend msg "`n", "*"
        ExitApp ok ? 0 : 1
    }
    MsgBox msg, "xx sync", ok ? 64 : 16
    ExitApp ok ? 0 : 1
}

ReadAllBytes(path) {
    f := FileOpen(path, "r")
    if !f
        throw Error("read fail")
    try {
        buf := Buffer(f.Length)
        if buf.Size
            f.RawRead(buf)
        return buf
    } finally f.Close()
}

WriteAllBytes(path, buf) {
    f := FileOpen(path, "w")
    if !f
        throw Error("write fail")
    try {
        if buf.Size
            f.RawWrite(buf)
    } finally f.Close()
}

HexHead(buf, n := 8) {
    n := Min(Integer(n), buf.Size)
    s := ""
    loop n
        s .= Format("{:02x} ", NumGet(buf, A_Index - 1, "UChar"))
    return Trim(s)
}

GetFullPath(p) {
    buf := Buffer(32768 * 2)
    n := DllCall("kernel32\GetFullPathNameW", "Str", p, "UInt", 32768, "Ptr", buf, "Ptr", 0, "UInt")
    return n ? StrGet(buf, "UTF-16") : p
}
GetDir(p) {
    SplitPath p, , &d
    return d
}
EscapePs(s) {
    return StrReplace(s, "'", "''")
}
FormatBytes(n) {
    n := Integer(n)
    if n < 1024
        return n " B"
    if n < 1048576
        return Format("{:.1f} KB", n / 1024)
    return Format("{:.2f} MB", n / 1048576)
}

